      },
      "person": {
        "type": "object",
        "required": [
          "name",
          "age",
          "zip",
          "relationship_to_typist"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/nonempty_string"
          },
          "age": {
            "type": "integer",
            "minimum": 0
          },
          "zip": {
            "type": "string",
            "enum": [
              "34102",
              "34103",
              "34104",
              "34105",
              "34108",
              "34109",
              "34110",
              "34112",
              "34113",
              "34114",
              "34116",
              "34117",
              "34119",
              "34120",
              "34145",
              "34142",
              "34139"
            ]
          },
          "relationship_to_typist": {
            "$ref": "#/$defs/nonempty_string"
          }
        }
      },
      "ground_truth": {
        "type": "object",
        "minProperties": 1,
        "description": "Hidden fictional facts; its internal field names were not fixed by the requested schema."
      },
      "opening_message": {
        "$ref": "#/$defs/nonempty_string"
      },
      "response_script": {
        "type": "array",
        "minItems": 6,
        "maxItems": 8,
        "items": {
          "type": "object",
          "required": [
            "if_asked_about",
            "reply"
          ],
          "additionalProperties": false,
          "properties": {
            "if_asked_about": {
              "$ref": "#/$defs/nonempty_string"
            },
            "reply": {
              "$ref": "#/$defs/nonempty_string"
            }
          }
        },
        "contains": {
          "type": "object",
          "required": [
            "if_asked_about"
          ],
          "properties": {
            "if_asked_about": {
              "type": "string",
              "pattern": "^Unprompted,"
            }
          }
        },
        "minContains": 2,
        "maxContains": 3,
        "description": "This fixture marks unconditional pushes with the Unprompted, prefix."
      },
      "stop_rule": {
        "$ref": "#/$defs/nonempty_string"
      },
      "answer_key": {
        "type": "object",
        "required": [
          "must_cover",
          "must_not_claim",
          "trap"
        ],
        "additionalProperties": false,
        "properties": {
          "must_cover": {
            "type": "array",
            "minItems": 3,
            "items": {
              "$ref": "#/$defs/nonempty_string"
            },
            "maxItems": 6
          },
          "must_not_claim": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/nonempty_string"
            },
            "maxItems": 4
          },
          "trap": {
            "$ref": "#/$defs/nonempty_string"
          }
        }
      },
      "grading_notes": {
        "$ref": "#/$defs/nonempty_string"
      }
    }
  },
