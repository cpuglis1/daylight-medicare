{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fictional Medicare evaluation personas",
  "description": "Requested object schema and structural counts. validate.py also checks corpus-level writing constraints and this fixture's dates. This schema does not certify Medicare advice or clinical accuracy.",
  "type": "array",
  "minItems": 20,
  "maxItems": 20,
  "items": {
    "type": "object",
    "required": [
      "id",
      "archetype",
      "person",
      "ground_truth",
      "opening_message",
      "response_script",
      "stop_rule",
      "answer_key",
      "grading_notes"
