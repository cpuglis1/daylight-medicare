+def source_text(spec, raw, support):
+    if raw.startswith(b"%PDF"):
+        text = subprocess.run(["pdftotext", "-layout", str(RAW / spec["sha256"]), "-"], capture_output=True, text=True, check=True).stdout
+        pages = text.split("\f")
