+"""Reviewed local cap changes, with synthetic ledgers and no provider requests."""
+from datetime import datetime, timezone
+import json
+from pathlib import Path
+from types import SimpleNamespace
+import sqlite3
+import sys
+import tempfile
+import threading
+import unittest
+from unittest.mock import patch
+
+HERE = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(HERE))
+import server  # Registers the read-only pinned imports.
+from ai_budget import BudgetError, DailyBudget, NANO
+from advisor_budget import AdvisorDailyBudget, APPROVED_CAP
+from natural_agent import TurnReservation
+
+
+NOW = datetime(2026, 10, 30, 16, tzinfo=timezone.utc).timestamp()
+
+
+def completed(i=1000, o=100):
+    return {'status': 'completed', 'model': 'gpt-5.4', 'service_tier': 'default',
+            'usage': {'input_tokens': i, 'output_tokens': o, 'total_tokens': i + o,
+                      'input_tokens_details': {'cached_tokens': 0}}}
+
+
+class AdvisorBudgetTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.path = Path(self.temp.name) / 'budget/usage.sqlite3'
+        self.now = [NOW]
+        self.base = DailyBudget(self.path, clock=lambda: self.now[0])
+
+    def local(self, budget=None):
+        return AdvisorDailyBudget.adopt(self.base if budget is None else budget)
+
+    def rows(self):
+        with sqlite3.connect(self.path) as db:
+            return db.execute('SELECT * FROM ai_charges ORDER BY id').fetchall()
+
+    def seed_usd(self, cents, key='prior'):
+        # Verified input-only price: 4,000 tokens per cent.
+        self.base.seed([(key, self.base.day(), cents * 4000, 0, 0)])
+
+    def policy(self, value):
+        path = Path(self.temp.name) / 'policy.json'
+        path.write_text(json.dumps(value))
+        return path
+
+    def test_adoption_preserves_identity_rows_inode_and_existing_holds(self):
+        key = self.base.reserve(1000, 900, 'gpt-5.4')
+        self.base.uncertain(key)
+        self.seed_usd(120)
+        before, inode = self.rows(), self.path.stat().st_ino
+        references = [self.base, SimpleNamespace(budget=self.base)]
+        closed_over_budget = lambda: self.base.summary()
+        local = self.local()
+        self.assertIs(local, references[0])
+        self.assertIs(local, references[1].budget)
+        self.assertEqual(self.rows(), before)
+        self.assertEqual(self.path.stat().st_ino, inode)
+        self.assertEqual(closed_over_budget()['dailyLimitUsd'], 5)
+        self.assertEqual(local.summary()['accountedUsd'], 1.216)
+        self.assertEqual(local.summary()['reservedOrUncertainUsd'], .016)
+        self.assertEqual(local.summary()['remainingUsd'], 3.784)
+
+    def test_original_writers_keep_one_dollar_policy_on_the_same_aggregate(self):
+        self.seed_usd(120)
+        local = self.local()
+        original = DailyBudget(self.path, clock=lambda: self.now[0])
+        self.assertEqual(original.summary()['dailyLimitUsd'], 1)
+        self.assertFalse(original.summary()['canRequest'])
+        with self.assertRaises(BudgetError):
+            original.reserve(1000, 900, 'gpt-5.4')
+        local.reserve(1000, 900, 'gpt-5.4')
+        self.assertEqual(local.summary()['accountedUsd'], original.summary()['accountedUsd'])
+        self.assertEqual(local.summary()['remainingUsd'], 3.784)
+
+    def test_single_request_accepts_exact_five_dollar_boundary_then_rejects(self):
+        self.base.seed([('prior', self.base.day(), 1986600, 0, 0)])
+        local = self.local()
+        local.reserve(8000, 900, 'gpt-5.4')
+        self.assertEqual(local.summary()['accountedUsd'], 5)
+        before = self.rows()
+        with self.assertRaises(BudgetError):
+            local.reserve(1, 900, 'gpt-5.4')
+        self.assertEqual(self.rows(), before)
+
+    def test_complete_two_stage_turn_can_spend_above_one_dollar(self):
+        self.seed_usd(120)
+        local = self.local()
+        with TurnReservation(local, 'gpt-5.4') as reservation:
+            self.assertIsNotNone(reservation.stage('extract').key)
+            self.assertIsNotNone(reservation.stage('compose').key)
+            self.assertEqual(local.summary()['reservedOrUncertainUsd'], .067)
+        self.assertEqual(local.summary()['accountedUsd'], 1.2)
+        self.assertEqual([row[6] for row in self.rows()].count('cancelled'), 2)
+
+    def test_complete_turn_rejection_is_atomic_with_one_stage_of_headroom(self):
+        self.seed_usd(495)
+        local = self.local()
+        before = self.rows()
+        with self.assertRaises(BudgetError):
+            TurnReservation(local, 'gpt-5.4')
+        self.assertEqual(self.rows(), before)
+
+    def test_concurrent_turns_cannot_each_claim_the_same_headroom(self):
+        self.seed_usd(490)
+        self.local()
+        barrier, results, reservations, errors = threading.Barrier(4), [], [], []
+        lock = threading.Lock()
+        def attempt():
+            try:
+                budget = self.local(DailyBudget(self.path, clock=lambda: NOW))
+                barrier.wait(timeout=10)
+                reservation = TurnReservation(budget, 'gpt-5.4')
+                with lock:
+                    results.append('reserved')
+                    reservations.append(reservation)
+            except BudgetError:
+                with lock:
+                    results.append('rejected')
+            except BaseException as error:
+                with lock:
+                    errors.append(error)
+        workers = [threading.Thread(target=attempt) for _ in range(4)]
+        for worker in workers:
+            worker.start()
+        for worker in workers:
+            worker.join(timeout=15)
+        try:
+            self.assertFalse(errors)
+            self.assertFalse(any(worker.is_alive() for worker in workers))
+            self.assertEqual(results.count('reserved'), 1)
+            self.assertEqual(results.count('rejected'), 3)
+            self.assertEqual(self.base.summary()['accountedUsd'], 4.967)
+        finally:
+            for reservation in reservations:
+                reservation.close()
+
+    def test_settlement_is_idempotent_and_uncertain_holds_cross_midnight(self):
+        local = self.local()
+        key = local.reserve(1000, 900, 'gpt-5.4')
+        local.settle(key, completed())
+        local.settle(key, completed())
+        held = local.reserve(1000, 900, 'gpt-5.4')
+        local.uncertain(held)
+        self.assertEqual(local.summary()['estimatedUsd'], .004)
+        self.now[0] += 86400
+        self.assertEqual(local.summary()['estimatedUsd'], 0)
+        self.assertEqual(local.summary()['reservedOrUncertainUsd'], .016)
+        self.assertEqual(local.summary()['remainingUsd'], 4.984)
+
+    def test_missing_usage_still_holds_and_blocks_all_paid_requests(self):
+        local = self.local()
+        key = local.reserve(1000, 900, 'gpt-5.4')
+        with self.assertRaises(BudgetError):
+            local.settle(key, {})
+        self.assertFalse(local.summary()['canRequest'])
+        self.assertEqual(local.summary()['reservedOrUncertainUsd'], .016)
+        with self.assertRaises(BudgetError):
+            local.reserve(1000, 900, 'gpt-5.4')
+        with self.assertRaises(BudgetError):
+            TurnReservation(local, 'gpt-5.4')
+
+    def test_rate_expiry_and_clock_rollback_cannot_create_allowance(self):
+        local = self.local()
+        local.summary()
+        self.now[0] -= 86400
+        self.assertFalse(local.summary()['canRequest'])
+        with self.assertRaises(BudgetError):
+            local.reserve(1000, 900, 'gpt-5.4')
+        self.now[0] = NOW + 8 * 86400
+        self.assertFalse(local.summary()['canRequest'])
+        with self.assertRaises(BudgetError):
+            TurnReservation(local, 'gpt-5.4')
+
+    def test_policy_must_be_exact_reviewed_integer_five_and_utc(self):
+        approved = {'version': 1, 'daily_cap_nano_usd': APPROVED_CAP, 'reset_timezone': 'UTC'}
+        invalid = [
+            {**approved, 'version': True}, {**approved, 'version': 2},
+            {**approved, 'daily_cap_nano_usd': NANO},
+            {**approved, 'daily_cap_nano_usd': 10 * NANO},
+            {**approved, 'daily_cap_nano_usd': float(APPROVED_CAP)},
+            {**approved, 'reset_timezone': 'America/New_York'},
+            {**approved, 'request_override': 5},
+        ]
+        for policy in invalid:
+            with self.subTest(policy=policy):
+                with self.assertRaises(BudgetError):
+                    AdvisorDailyBudget.adopt(self.base, policy_path=self.policy(policy))
+                self.assertIs(type(self.base), DailyBudget)
+        with self.assertRaises(BudgetError):
+            AdvisorDailyBudget.adopt(self.base, policy_path=Path(self.temp.name) / 'absent')
+
+    def test_environment_and_instance_assignment_cannot_increase_policy(self):
+        with patch.dict('os.environ', {'DAYLIGHT_AI_DAILY_CAP': '500', 'OPENAI_DAILY_LIMIT': '500'}):
+            local = self.local()
+            self.assertEqual(local.summary()['dailyLimitUsd'], 5)
+            with self.assertRaises(AttributeError):
+                local.daily_cap_nano_usd = 500 * NANO
+        self.assertEqual(local.summary()['dailyLimitUsd'], 5)
+
+    def test_original_token_limits_and_pricing_are_unchanged(self):
+        local = self.local()
+        for i, o in [(8001, 900), (0, 900), (1000, 901), (1000, 899), (True, 900)]:
+            with self.assertRaises(BudgetError):
+                local.reserve(i, o, 'gpt-5.4')
+        with self.assertRaises(BudgetError):
+            local.reserve(1000, 900, 'another-model')
+        self.assertFalse(self.rows())
+
+    def service_stub(self):
+        budget = self.base
+        agent = SimpleNamespace(budget=budget)
+        adaptive = SimpleNamespace(agent=SimpleNamespace(budget=budget),
+                                   validate=lambda guide, record: (guide, record),
+                                   initial=lambda: ({}, {}))
+        return SimpleNamespace(
+            RequestHandlerClass=type('FixtureHandler', (), {}),
+            budget=budget, agent=agent,
+            readiness_agent=SimpleNamespace(budget=budget),
+            readiness_conversation=SimpleNamespace(agent=SimpleNamespace(budget=budget)),
+            adaptive=adaptive,
+            profile_gate=SimpleNamespace(validate_inputs=lambda guide, record: (guide, record)),
+            profiles=SimpleNamespace(save=lambda *args: None, delete=lambda *args: None),
+            handler_status=lambda: budget.summary(),
+            server_close=lambda: None)
+
+    def test_local_service_adopts_one_object_for_status_and_every_agent(self):
+        service = self.service_stub()
+        with patch.object(server, 'make_server', return_value=service):
+            built = server.build(0, fixture=True, database=Path(self.temp.name) / 'guides.sqlite3')
+        self.assertIs(built, service)
+        references = [built.agent.budget, built.readiness_agent.budget,
+                      built.readiness_conversation.agent.budget, built.adaptive.agent.budget]
+        self.assertTrue(all(value is built.budget for value in references))
+        self.assertEqual(built.handler_status()['dailyLimitUsd'], 5)
+        self.assertIs(type(built.budget), AdvisorDailyBudget)
+
+    def test_policy_startup_failure_closes_service_before_return(self):
+        service, closed = self.service_stub(), []
+        service.server_close = lambda: closed.append(True)
+        with patch.object(server, 'make_server', return_value=service), \
+                patch.object(server.AdvisorDailyBudget, 'adopt', side_effect=BudgetError('policy unavailable')):
+            with self.assertRaises(BudgetError):
+                server.build(0, fixture=True, database=Path(self.temp.name) / 'guides.sqlite3')
+        self.assertEqual(closed, [True])
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/alternatives/advisor-first/tests/test_advisor_memory.py b/alternatives/advisor-first/tests/test_advisor_memory.py
new file mode 100644
index 0000000..624259e
--- /dev/null
+++ b/alternatives/advisor-first/tests/test_advisor_memory.py
@@ -0,0 +1,159 @@
+"""Bounded visit-only context contracts; no network, model or profile store."""
+from pathlib import Path
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from advisor_memory import (CONTEXT_POLICY, HISTORY_LIMIT, HISTORY_TTL,
+                            VISIT_LIMIT, VisitMemory)
+
+
+class VisitMemoryTests(unittest.TestCase):
+    def setUp(self):
+        self.now = 100.0
+        self.memory = VisitMemory(clock=lambda: self.now)
+
+    def remember(self, **changes):
+        values = dict(owner='owner', chain='chain', policy=CONTEXT_POLICY,
+                      user='My question', reply='An explanation', question='',
+                      candidate_ids=('T05', 'RC11'))
+        values.update(changes)
+        return self.memory.remember(**values)
+
+    def recent(self, owner='owner', chain='chain', policy=CONTEXT_POLICY):
+        return self.memory.recent(owner, chain, policy)
+
+    def brief(self, owner='owner', chain='chain', policy=CONTEXT_POLICY):
+        return self.memory.brief(owner, chain, policy)
+
+    def test_cross_topic_side_answer_preserves_goal_and_return_point(self):
+        self.remember(question='What insurance do you have?', question_target='T05',
+                      goal='Understand my options and prepare to enroll',
+                      agenda_update={'current_concern': 'enrollment timing', 'pause': False})
+        self.remember(user='What is Part B?', reply='A reviewed explanation',
+                      agenda_update={'current_concern': 'Part B'})
+        self.assertEqual([x['user'] for x in self.recent()],
+                         ['My question', 'What is Part B?'])
+        self.assertEqual(self.brief(), {
+            'goal': 'Understand my options and prepare to enroll',
+            'current_concern': 'Part B', 'pending_question': 'T05', 'paused': False})
+        self.remember(question_target='', agenda_update={'pause': True})
+        self.assertEqual(self.brief()['pending_question'], 'T05')
+        self.assertTrue(self.brief()['paused'])
+        self.remember(question_target='RC11', agenda_update={'pause': False})
+        self.assertEqual(self.brief()['pending_question'], 'RC11')
+
+    def test_owner_chain_isolation_and_exact_text(self):
+        self.remember(user='  I said "November".\n', reply='First', question='Which year?')
+        self.remember(owner='other', reply='Another owner')
+        self.remember(chain='other-chain', reply='Another visit')
+        self.assertEqual(self.recent(), [{'user': '  I said "November".\n',
+                                         'assistant': 'First', 'question': 'Which year?'}])
+        self.assertEqual(self.recent(owner='unknown'), [])
+        self.memory.clear('owner', 'chain')
+        self.assertEqual(self.recent(), [])
+        self.assertEqual(self.recent(owner='other')[0]['assistant'], 'Another owner')
+        self.assertEqual(self.recent(chain='other-chain')[0]['assistant'], 'Another visit')
+
+    def test_older_permissions_cannot_read_or_extend_cross_topic_memory(self):
+        for policy in (None, 'natural-context-v1', 'natural-context-v2', 'unknown'):
+            with self.subTest(policy=policy):
+                self.remember(goal='My explicit goal', question_target='T05')
+                self.assertEqual(self.recent(policy=policy), [])
+                self.assertEqual(self.brief(), {})
+                self.assertFalse(self.remember(policy=policy, goal='Not authorized'))
+                self.assertEqual(self.recent(), [])
+                self.remember(question_target='T05')
+                self.assertEqual(self.brief(policy=policy), {})
+                self.assertEqual(self.recent(), [])
+
+    def test_ttl_expires_without_read_renewal(self):
+        self.remember(goal='My goal')
+        self.now += HISTORY_TTL - 1
+        self.assertTrue(self.recent())
+        self.now += 1
+        self.assertEqual(self.recent(), [])
+        self.assertEqual(self.brief(), {})
+
+    def test_new_exchange_renews_ttl(self):
+        self.remember()
+        self.now += HISTORY_TTL - 1
+        self.remember(user='Another question')
+        self.now += 2
+        self.assertEqual(len(self.recent()), 2)
+
+    def test_chronological_six_exchange_limit_with_brief_surviving_eviction(self):
+        self.remember(user='0', goal='Explicit goal', question_target='T05')
+        for index in range(1, 9):
+            self.remember(user=str(index))
+        self.assertEqual([x['user'] for x in self.recent()], list(map(str, range(3, 9))))
+        self.assertEqual(self.brief()['goal'], 'Explicit goal')
+        self.assertEqual(self.brief()['pending_question'], 'T05')
+
+    def test_total_character_bound_preserves_complete_exchanges(self):
+        for index in range(6):
+            self.remember(user=str(index) * 1200, reply='r' * 200)
+        exchanges = self.recent()
+        self.assertLessEqual(sum(len(v) for item in exchanges for v in item.values()), HISTORY_LIMIT)
+        self.assertEqual(len(exchanges), 3)
+        self.assertEqual(exchanges[0]['user'], '3' * 1200)
+
+    def test_oversize_exchange_is_omitted_without_clipping_or_losing_brief(self):
+        self.remember(user='Earlier complete message')
+        self.remember(user='x' * (HISTORY_LIMIT + 1), goal='Updated explicit goal',
+                      question_target='RC11', agenda_update={'current_concern': 'Timing'})
+        self.assertEqual(len(self.recent()), 1)
+        self.assertEqual(self.recent()[0]['user'], 'Earlier complete message')
+        self.assertEqual(self.brief()['goal'], 'Updated explicit goal')
+        self.assertEqual(self.brief()['pending_question'], 'RC11')
+
+    def test_invalid_mutations_are_atomic(self):
+        self.remember(goal='Original goal', question_target='T05')
+        before_history, before_brief = self.recent(), self.brief()
+        invalid = [
+            {'question_target': 'RC11', 'candidate_ids': ('T05',)},
+            {'question_target': 'not-a-question', 'candidate_ids': ('not-a-question',)},
+            {'agenda_update': {'goal': 'Unvalidated goal'}},
+            {'agenda_update': {'pending_question': 'RC11'}},
+            {'agenda_update': {'current_concern': 'x' * 161}},
+            {'agenda_update': {'pause': 1}},
+            {'goal': 'x' * 201}, {'user': 'x' * 8001},
+            {'reply': None}, {'question': 'x' * 2001},
+            {'candidate_ids': 'T05'}, {'owner': None}, {'chain': None},
+        ]
+        for changes in invalid:
+            with self.subTest(changes=list(changes)):
+                with self.assertRaises(ValueError):
+                    self.remember(**changes)
+                self.assertEqual(self.recent(), before_history)
+                self.assertEqual(self.brief(), before_brief)
+
+    def test_explicit_clear_and_copy_isolation(self):
+        update = {'current_concern': 'Part B', 'pause': True}
+        self.remember(goal='Explicit goal', agenda_update=update)
+        update['current_concern'] = 'Mutated outside memory'
+        self.brief()['goal'] = 'Changed returned value'
+        self.recent()[0]['user'] = 'Changed returned history'
+        self.assertEqual(self.brief()['goal'], 'Explicit goal')
+        self.assertEqual(self.brief()['current_concern'], 'Part B')
+        self.assertEqual(self.recent()[0]['user'], 'My question')
+        self.remember(goal='', agenda_update={'current_concern': None, 'pause': False})
+        self.assertEqual(self.brief(), {'paused': False})
+
+    def test_visit_count_bound_evicts_oldest_updated_visit(self):
+        for index in range(VISIT_LIMIT):
+            self.remember(chain=str(index))
+        self.remember(chain='0', user='Renewed visit')
+        self.remember(chain='new')
+        self.assertEqual(self.recent(chain='1'), [])
+        self.assertEqual(self.recent(chain='0')[-1]['user'], 'Renewed visit')
+        self.assertEqual(len(self.memory._visits), VISIT_LIMIT)
+
+    def test_missing_visit_reads_are_empty(self):
+        self.assertEqual(self.recent(chain=None), [])
+        self.assertEqual(self.brief(owner=None), {})
+        self.memory.clear(None, None)
+
+
+if __name__ == '__main__':
+    unittest.main()
