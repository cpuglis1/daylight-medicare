+/* ALT73 simplification: one conversation column; incumbent landing and tokens unchanged. */
+body.chat-mode{background:var(--paper,#fbf9f4)}
+.chat-mode .site-header{width:min(780px,calc(100% - 40px));max-width:780px;min-height:68px;margin:0 auto;padding:0}
+.chat-mode #main{display:block;min-height:0;flex:none}
+.chat-mode #stage{width:100%;max-width:780px;min-height:0;padding:0 20px;margin:0 auto;outline:none}
+.chat-mode .site-footer{display:none}
+.chat-workspace{height:calc(100dvh - 80px);min-height:320px;display:flex;flex-direction:column;border:0;background:transparent;overflow:hidden}
+.chat-tools{display:flex;align-items:center;gap:4px 16px;flex-wrap:wrap;margin:0;padding:0 0 4px}
+.chat-tools button,.chat-composer-tools button{font:16px/1.4 'Atkinson Hyperlegible',Arial,sans-serif;min-height:44px;max-width:none;padding:5px 0;background:none;border:0;box-shadow:none;color:#596653;white-space:normal;text-decoration:underline;text-underline-offset:4px}
+.chat-tools button:last-child{margin-left:auto}
+.chat-small{font-size:16px;line-height:1.4;color:#596653;margin:0}
+.chat-progress{flex:none;margin:0 0 10px;padding:0}
+.chat-progress-label{display:flex;justify-content:space-between;gap:12px;font-size:16px;line-height:1.4;color:#596653}
+.chat-progress progress{display:block;width:100%;height:4px;border:0;border-radius:4px;margin:5px 0 0;background:#e8eddf;color:#40513d;accent-color:#40513d}
+.chat-progress progress::-webkit-progress-bar{background:#e8eddf;border-radius:4px}
+.chat-progress progress::-webkit-progress-value{background:#40513d;border-radius:4px}
+.chat-progress progress::-moz-progress-bar{background:#40513d;border-radius:4px}
+.chat-reading{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;padding:10px 4px 16px;scrollbar-color:#a8b19e #fbf9f4;scrollbar-width:thin}
+.chat-message{max-width:72ch;margin:0 0 18px;padding:0;overflow-wrap:anywhere}
+.chat-message:last-child{margin-bottom:8px}
+.chat-message h2{font:400 22px/1.4 'Atkinson Hyperlegible',Arial,sans-serif;letter-spacing:0;margin:0 0 6px;text-wrap:initial}
+.chat-message p{font-size:18px;line-height:1.5;margin:0 0 6px;white-space:pre-wrap}
+.chat-message .chat-why{font-size:16px;line-height:1.45;color:#596653;margin:0}
+.chat-message details{font-size:16px;margin-top:6px}
+.chat-message summary{cursor:pointer;min-height:36px;line-height:1.5}
+.chat-message a{display:block;min-height:36px;padding:4px 0}
+.chat-user{margin-left:auto;padding:10px 14px;background:#e8eddf;border-radius:8px;max-width:85%;width:fit-content}
+.chat-user p{margin:0}
+.chat-daylight ul{padding-left:24px;line-height:1.5;font-size:17px}
+.chat-suggestions{margin:0;padding:0;border:0;overflow:visible}
+.chat-option-row{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin:0}
+.chat-option-row button{min-height:44px;max-width:100%;font:16px/1.35 'Atkinson Hyperlegible',Arial,sans-serif;padding:8px 12px;border:1px solid #ccd3c1;border-radius:7px;background:#fffefa;color:#283b30;text-align:left;box-shadow:none;overflow-wrap:anywhere}
+.chat-option-row button:hover{background:#e8eddf}
+.chat-option-row button[aria-pressed=true]{background:#d5dfc9;border-color:#40513d;box-shadow:inset 0 0 0 1px #40513d}
+.chat-alternatives{display:contents}
+.chat-alternatives button{border-color:transparent;background:transparent;color:#596653;text-decoration:underline;text-underline-offset:4px}
+.chat-suggestions>.chat-small{margin:0 0 6px}
+.chat-detail-fields{display:flex;flex-wrap:wrap;gap:10px;margin:10px 0}
+.chat-field{flex:1 1 220px;min-width:0;max-width:100%}
+.chat-field label{display:block;font-size:16px;line-height:1.4;margin-bottom:4px}
+.chat-field input,.chat-field select{width:100%;min-height:44px;font:18px/1.4 'Atkinson Hyperlegible',Arial,sans-serif;color:#283b30;background:#fffefa;border:1px solid #a8b19e;border-radius:7px;padding:8px 10px;box-sizing:border-box}
+.chat-suggestions>.primary-button{font-size:16px;padding:8px 14px;min-height:44px;margin:8px 8px 0 0}
+.chat-workspace .chat-composer{position:relative;flex:none;padding:8px 0 0;margin:0;border:0;background:var(--paper,#fbf9f4);box-shadow:none}
+.chat-input-row{display:flex;gap:8px;align-items:flex-end;padding:8px;border:1px solid #a8b19e;border-radius:12px;background:#fffefa}
+.chat-input-row textarea{flex:1;min-width:0;min-height:56px;max-height:130px;resize:vertical;font:18px/1.4 'Atkinson Hyperlegible',Arial,sans-serif;color:#283b30;border:0;border-radius:7px;background:transparent;padding:6px 8px;caret-color:#40513d;box-shadow:none}
+.chat-input-row textarea::placeholder{color:#596653;opacity:1}
+.chat-input-row button{min-height:44px;font-size:17px;padding:8px 16px}
+.chat-composer-tools{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:0;padding:0 2px}
+.chat-composer-tools .chat-small{margin-left:auto}
+.chat-disclosure{padding:0 2px 8px}
+.chat-status{font-size:16px;line-height:1.4;margin:4px 2px 8px;color:#40513d}
+.chat-status:empty{display:none}
+.chat-review-row{padding:16px 0;border-bottom:1px solid #ccd3c1}
+.chat-review-row h3{font-size:20px;margin:0 0 6px}
+.chat-review-row p{white-space:pre-wrap;overflow-wrap:anywhere}
+.chat-review-row button{margin-top:6px}
+.chat-plan-view{padding-top:16px!important}
+.chat-plan-view h1{font-size:38px}
+.chat-plan-view .sample-plan{max-width:740px}
+.chat-mode button:focus-visible,.chat-mode textarea:focus-visible,.chat-mode input:focus-visible,.chat-mode select:focus-visible,.chat-mode a:focus-visible,.chat-mode summary:focus-visible{outline:3px solid #91600c;outline-offset:3px}
+.chat-mode ::selection{background:#d5dfc9;color:#283b30}
+.chat-mode button:disabled{opacity:.55;cursor:default}
+@media(max-width:520px){
+ .chat-mode .site-header{width:calc(100% - 32px);min-height:64px}
+ .chat-mode #stage{padding:0 16px}
+ .chat-workspace{height:calc(100dvh - 70px);min-height:260px}
+ .chat-tools{gap:4px 12px}
+ .chat-progress{margin-bottom:6px}
+ .chat-reading{padding:8px 2px 12px}
+ .chat-message h2{font-size:21px}
+ .chat-message{margin-bottom:16px}
+ .chat-option-row{gap:4px 6px}
+ .chat-option-row button{padding:8px 10px}
+ .chat-field{flex-basis:100%}
+ .chat-input-row{gap:4px;padding:6px}
+ .chat-input-row textarea{padding:6px;min-height:50px}
+ .chat-input-row button{padding:8px 12px}
+ .chat-composer-tools{gap:4px 10px}
+ .chat-composer-tools .chat-small{font-size:16px}
+}
+
+.chat-entry-label{display:block;font-size:16px;line-height:1.4;color:#596653;margin:0 0 6px}
+
+.profile-readiness-message{font-size:18px;line-height:1.5;margin:8px 0 12px;max-width:70ch}.chat-suggestions>details{font-size:16px;line-height:1.5;margin:6px 0}.chat-suggestions>details summary{min-height:44px;cursor:pointer}
