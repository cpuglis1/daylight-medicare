+LARGE = {"L03", "L07", "L08"}
+DRIVER = "infrastructure/daylight-data/tools/benchmark_local_layers.py"
+
+
+def read(path):
+    return json.loads(path.read_text())
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
