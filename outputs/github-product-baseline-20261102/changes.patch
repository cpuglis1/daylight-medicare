+                       "raw_pdf_sha256": None, "acceptance": "pending"}})
+    medical = [r for r in catalog["options"]+catalog["exclusions"] if r["category"] != "PDP"]
+    provider_rows = [{"hospital_system": hospital, "plan_id": row["id"], "year": "2027", "provider_identity": None,
