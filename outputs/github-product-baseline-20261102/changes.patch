+                        'physical_page': number, 'span_ordinal': span['span_ordinal'],
+                        'left': span['left'], 'top': span['top'], 'width': span['width'],
+                        'height': span['height'], 'raw_native_text': span['raw_native_text']})
+    for number in range(44, 113):
