+.map-caption{font-size:14px;line-height:1.45;color:var(--muted);margin:12px 0}.flow-picture>details{font-size:15px;margin-top:12px}.flow-picture>details summary{min-height:40px;cursor:pointer}
+.ask-panel{width:min(600px,calc(100vw - 32px));right:16px;max-height:calc(100dvh - 24px)}
+.ask-head{padding:16px 20px;gap:12px;flex-wrap:nowrap;align-items:center}.ask-head>div{min-width:0}.ask-title{font-size:28px;line-height:1.15}.ask-title span{font:400 14px/1.3 'Atkinson Hyperlegible',Arial,sans-serif;white-space:nowrap}
+.ask-context{font-size:14px;line-height:1.3;margin:4px 0 0;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}
+.ask-head .secondary-button{font-size:15px;min-height:44px;padding:8px 0;max-width:70px;background:none;border:0;box-shadow:none}
+.ask-reading{padding:18px 22px}.ask-question{font-size:25px}.ask-intro,.ask-availability{display:none}.ask-canned{padding-top:14px}.ask-canned-q{padding:10px 12px;font-size:16px;min-height:44px}.ask-canned h3{display:none}
+.ask-form{padding:12px 20px max(12px,env(safe-area-inset-bottom))}.ask-form label{font-size:16px;margin-bottom:6px}.ask-input-row{gap:10px}.chat-disclosure{font-size:14px;line-height:1.35;margin:8px 0 0}.ask-form .ask-status:empty{display:none}.ask-status.sr-only{margin:0}
+.agent-proposals h3{font:450 28px/1.15 Fraunces,Georgia,serif;margin:0 0 14px}.agent-proposals .primary-button{width:100%;margin-top:16px}.agent-proposals>.secondary-button{display:block;border:0;background:none;padding:10px 0;box-shadow:none;text-align:left;min-height:44px}.agent-proposals .flow-original{font-size:17px}.proposal-next{font-size:16px;line-height:1.45}
+@media(max-width:1000px){.flow-layout{column-gap:34px}.coverage-architecture{padding:18px}.coverage-arrangements{gap:12px}.coverage-parts{flex-direction:column}.coverage-arrangements h3{font-size:21px}}
+@media(max-width:760px){.flow-layout{display:grid;grid-template-columns:minmax(0,1fr);gap:20px;padding-top:24px}.flow-task-intro{grid-column:1;grid-row:1}.flow-layout>.flow-picture{grid-column:1;grid-row:2}.flow-task{grid-column:1;grid-row:3}.flow-layout:has(>.flow-picture[hidden]) .flow-task{grid-row:2}.flow-task-intro h1{font-size:38px;line-height:1.12}.task-teaching{font-size:18px;margin-top:14px}.coverage-architecture{gap:13px;padding:16px}.coverage-arrangements{gap:12px}.coverage-parts{flex-direction:row}.coverage-arrangements h3{font-size:19px}.coverage-piece{font-size:15px}.flow-picture-head h2{font-size:20px}.flow-picture-head{margin-bottom:10px}.map-caption{font-size:13px}.flow-picture>details{font-size:14px}.agent-launcher{font-size:16px}.paired-question legend{font-size:18px}.ask-panel{right:10px;width:calc(100vw - 20px);max-height:calc(100dvh - 16px)}.ask-head{padding:12px 16px}.ask-title{font-size:24px}.ask-title span{font-size:12px}.ask-head .secondary-button{font-size:14px}.ask-reading{padding:16px 18px}.ask-form{padding:10px 16px max(10px,env(safe-area-inset-bottom))}.chat-disclosure{font-size:13px}.ask-question{font-size:24px}}
+@media(max-width:360px){.coverage-arrangements{grid-template-columns:1fr}.coverage-advantage{padding:14px 0 0;border-left:0;border-top:1px solid var(--line)}.ask-title{font-size:21px}.ask-title span{font-size:11px}.flow-task-intro h1{font-size:34px}}
+/* Selected choices retain the same text alignment as unselected choices. */
+.flow-task .choice { justify-content:flex-start; }
+.flow-task .choice[aria-pressed="true"]::before { flex:0 0 9px; margin-right:10px; }
+
+/* A pending interpretation has one primary confirmation; revising its text stays secondary. */
+.ask-form #ask-send.review-again{background:var(--sage);color:var(--ink);border:1px solid var(--line);}
