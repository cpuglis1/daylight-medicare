+NPI = '1000000001'
+ACTOR = 'fixture.invalid/Practitioner/one'
+LOCATION = 'fixture.invalid/Location/one'
+SOURCE_PATH = 'docs/data/l08-provider-networks-2026-10-27/wellcare-r5/providers.sqlite3'
