+    outputs = {'source-audit.json': audit, 'input-bindings.json': bindings,
+        'native-id-request.json': {'offering_id': OFFERING, **ids},
+        'CMS-service-index.json': cms_index, 'inpatient-scope.json': inpatient_scope(rows, cms_index),
