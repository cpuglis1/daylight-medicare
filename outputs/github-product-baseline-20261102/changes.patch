+def _controls(root):
+    result = {}
+    for name, expected in CONTROL_HASHES.items():
+        path = root / BASE / name
+        if sha256_file(path) != expected:
+            raise ValueError(f'Selected source control hash changed: {path}')
+        with path.open(encoding='utf-8') as handle:
+            result[name] = json.load(handle)
+    return result
