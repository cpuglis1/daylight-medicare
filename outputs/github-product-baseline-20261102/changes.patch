@@ -0,0 +1,120 @@
+"""Pin query selection to completed immutable local-build controls, not 'latest'."""
+from dataclasses import dataclass
+from pathlib import Path
+import hashlib
+import json
+import re
+
+VERSION = 'collier-research-serving-r1'
+PACKET = 'docs/data/infrastructure-execution-2026-10-30-local-full-db/build-r3'
+SCOPE = {'year': 2026, 'state': 'FL', 'county_fips': '12021', 'category': 'medicare_advantage'}
+SELECTION = {
+    'collier': ('L02', 'collier_offerings', '/build-r5/12021/'),
+    'national': ('L02', 'offerings', '/build-r5/'),
+    'semantic': ('L03', 'semantic_unit', '/semantic-inventory-r9/'),
+    'quality': ('L09', 'observations', '/build-r4/'),
+    'quality_binding': ('L09', 'offerings', '/build-r4/'),
+}
+
+
+class ResearchServingError(ValueError):
+    """Fixed-code failures must not contain source text, DSNs or personal data."""
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False,
+                      allow_nan=False).encode()
+
+
+def digest(value):
+    return hashlib.sha256(canonical(value)).hexdigest()
+
+
+def _json(root, path):
+    if (path.is_symlink() or not path.resolve().is_relative_to(root)
+            or not path.is_file() or path.stat().st_size > 8 * 1024**2):
+        raise ResearchServingError('PINNED_CONTROL_UNAVAILABLE')
+    for parent in path.parents:
+        if parent == root:
+            break
+        if parent.is_symlink():
+            raise ResearchServingError('PINNED_CONTROL_SYMLINK')
+    data = path.read_bytes()
+    try:
+        return json.loads(data), hashlib.sha256(data).hexdigest()
+    except (TypeError, ValueError):
+        raise ResearchServingError('PINNED_CONTROL_INVALID') from None
+
+
+@dataclass(frozen=True)
+class ResearchBinding:
+    build_id: str
+    database: str
+    manifest_sha256: str
+    target: dict
+    selections: dict
+    unit_receipts: tuple
+    control_hashes: dict
+    adapter_sha256: str
+
+    @property
+    def binding_id(self):
+        return digest({'version': VERSION, 'build_id': self.build_id,
+                       'manifest_sha256': self.manifest_sha256,
+                       'selections': self.selections, 'controls': self.control_hashes,
+                       'adapter_sha256': self.adapter_sha256})
+
+
+def load_local_binding(repository_root, packet=PACKET, *, selection=None):
+    root = Path(repository_root).resolve()
+    directory = root / packet
+    manifest, manifest_hash = _json(root, directory / 'BUILD_MANIFEST.json')
+    target, target_hash = _json(root, directory / 'TARGET.json')
+    complete, complete_hash = _json(root, directory / 'LOAD_COMPLETE.json')
+    build_id = digest(manifest)
+    if (manifest.get('schema') != 'daylight-local-full-build/2'
+            or target.get('build_id') != build_id or complete.get('build_id') != build_id
+            or manifest.get('database') != target.get('database')
+            or complete.get('target') != target
+            or manifest.get('consumer_release_enabled') is not False
+            or complete.get('consumer_release_enabled') is not False
+            or manifest.get('new_acceptance') is not False or complete.get('new_acceptance') is not False
+            or complete.get('source_rows') != 17767179 or complete.get('projection_rows') != 17823148
+            or complete.get('unit_receipts') != 363):
+        raise ResearchServingError('COMPLETED_BUILD_BINDING_MISMATCH')
+    hashes = {'BUILD_MANIFEST.json': manifest_hash, 'TARGET.json': target_hash,
+              'LOAD_COMPLETE.json': complete_hash}
+    required = SELECTION if selection is None else selection
+    selections, receipts = {}, []
+    # These are the 363 declared execution receipts, not a scan of source trees.
+    files = sorted((directory / 'units').glob('*.json'))
+    if len(files) != 363:
+        raise ResearchServingError('UNIT_RECEIPT_ACCOUNTING_MISMATCH')
+    for path in files:
+        receipt, receipt_hash = _json(root, path)
+        binding = receipt.get('binding', {})
+        matches = [key for key, (layer, table, part) in required.items()
+                   if binding.get('layer_id') == layer and binding.get('source_table') == table
+                   and part in binding.get('source_path', '')]
+        if not matches:
+            continue
+        if (receipt.get('build_id') != build_id or receipt.get('database_verified') is not True
+                or receipt.get('new_acceptance') is not False or path.stem != receipt.get('selected_slot')
+                or not re.fullmatch('[a-f0-9]{64}', binding.get('derivation_id', ''))
+                or manifest['selected_source_files'].get(binding.get('source_path')) != binding.get('source_sha256')):
+            raise ResearchServingError('SELECTED_UNIT_RECEIPT_MISMATCH')
+        native = {key: binding[key] for key in ('layer_id', 'source_path', 'source_table',
+                                               'source_sha256', 'derivation_id', 'adapter_code_sha256')}
+        for key in matches:
+            if key in selections and selections[key] != native:
+                raise ResearchServingError('AMBIGUOUS_SELECTED_DERIVATION')
+            selections[key] = native
+        receipts.append({'job_id': receipt['job_id'], 'source_rows': receipt['source_rows'],
+                         'stream_sha256': receipt['stream_sha256'], 'selected_slot': receipt['selected_slot']})
+        hashes['units/' + path.name] = receipt_hash
+    if set(selections) != set(required):
+        raise ResearchServingError('REQUIRED_DERIVATION_ABSENT')
+    code_hashes = {p.name: hashlib.sha256(p.read_bytes()).hexdigest()
+                   for p in sorted(Path(__file__).parent.glob('*.py'))}
+    return ResearchBinding(build_id, target['database'], manifest_hash, target, selections,
+                           tuple(receipts), hashes, digest(code_hashes))
diff --git a/infrastructure/daylight-data/src/daylight_data/serving/drug_candidates.py b/infrastructure/daylight-data/src/daylight_data/serving/drug_candidates.py
new file mode 100644
index 0000000..255afc1
--- /dev/null
+++ b/infrastructure/daylight-data/src/daylight_data/serving/drug_candidates.py
@@ -0,0 +1,192 @@
+"""Literal dictionary discovery for operator-reviewed identity candidates only.
+
+Text occurrence is not clinical equivalence, strength equivalence, coverage or
+identity confirmation. Source names, packs, missing details and dates survive.
+No synonyms, fuzzy scores, brand expansion, unit conversion or customer binding.
+"""
+import json
+import re
+
+from .binding import ResearchServingError, digest, load_local_binding
+from .identity import (ACCESS, SELECTION, EXPECTED_DICTIONARY_ROWS, DrugIdentityRepository,
+                       _candidate)
+from .repository import json_safe, repository_from_env
+
+
+VERSION = 'l05-literal-drug-candidates-research-r1'
+MAX_TEXT_CHARS = 160
+MAX_PAGE = 20
+MAX_RESPONSE_BYTES = 2 * 1024 * 1024
+CONTROL_CHAR = re.compile(r'[\x00-\x1f\x7f-\x9f]')
+SOURCE_ACCESS_IDS = ('sealed-local:L05', 'L05')
+EXPECTED_CONTROLS = {'rows': EXPECTED_DICTIONARY_ROWS, 'min_year': 2026, 'max_year': 2026,
+                     'offering_rows': 0, 'missing_name': 0, 'missing_strength': 28,
+                     'missing_form': 28, 'pack_rows': 285}
+
+CONTROLS = """SELECT count(*) AS rows,min(benefit_year) AS min_year,
+ max(benefit_year) AS max_year,count(offering_id) AS offering_rows,
+ count(*) FILTER(WHERE NULLIF(btrim(fields->>'drug_name'),'') IS NULL) AS missing_name,
+ count(*) FILTER(WHERE NULLIF(btrim(fields->>'ingredient_strength_description'),'') IS NULL) AS missing_strength,
+ count(*) FILTER(WHERE NULLIF(btrim(fields->>'dose_form'),'') IS NULL) AS missing_form,
+ count(*) FILTER(WHERE fields->>'concept_type' IN ('GPCK','BPCK')) AS pack_rows
+ FROM dl_evidence.observation WHERE derivation_id=%s AND entity_type='drug_product'
+ AND source_table='drug_identities'"""
+
+# The existing source-lineage index bounds this to 4,547 records. Optional text
+# filters retain name-matched records whose source strength/form is absent. The
+# fixed ! escape makes percent/underscore/exclamation literal user characters.
+SEARCH = """WITH matched AS MATERIALIZED (
+ SELECT * FROM dl_evidence.observation WHERE derivation_id=%s
+ AND entity_type='drug_product' AND source_table='drug_identities'
+ AND source_row_ordinal>%s AND fields->>'drug_name' ILIKE %s ESCAPE '!'
+ AND (%s::text IS NULL OR NULLIF(btrim(fields->>'ingredient_strength_description'),'') IS NULL
+      OR fields->>'ingredient_strength_description' ILIKE %s ESCAPE '!')
+ AND (%s::text IS NULL OR NULLIF(btrim(fields->>'dose_form'),'') IS NULL
+      OR fields->>'dose_form' ILIKE %s ESCAPE '!')
+ ORDER BY source_row_ordinal LIMIT %s)
+ SELECT o.*,r.raw_payload,r.raw_sha256,r.record_id,r.source_row_key,r.ordinal_basis,
+ d.snapshot_id,d.adapter_code_sha256,s.original_path,s.artifact_sha256,
+ s.source_use_state AS snapshot_source_use_state,
+ o.fields->>'drug_name' ILIKE %s ESCAPE '!' AS name_literal_observed,
+ CASE WHEN NULLIF(btrim(o.fields->>'ingredient_strength_description'),'') IS NULL THEN NULL
+      ELSE o.fields->>'ingredient_strength_description' ILIKE %s ESCAPE '!' END AS strength_literal_observed,
+ CASE WHEN NULLIF(btrim(o.fields->>'dose_form'),'') IS NULL THEN NULL
+      ELSE o.fields->>'dose_form' ILIKE %s ESCAPE '!' END AS form_literal_observed
+ FROM matched o JOIN dl_evidence.source_record r USING(derivation_id,source_table,source_row_ordinal)
+ JOIN dl_control.derivation d USING(derivation_id)
+ JOIN dl_control.source_snapshot s USING(snapshot_id) ORDER BY o.source_row_ordinal"""
+
+
+def _text(value, *, optional=False):
+    if optional and value is None:
+        return None
+    if (not isinstance(value, str) or not value.strip() or len(value) > MAX_TEXT_CHARS
+            or CONTROL_CHAR.search(value)):
+        raise ResearchServingError('INVALID_LITERAL_DRUG_REQUEST')
+    return value.strip()
+
+
+def _pattern(text):
+    if text is None:
+        return None
+    return '%' + text.replace('!', '!!').replace('%', '!%').replace('_', '!_') + '%'
+
+
+def _field_state(row, candidate, text, field, observed_key):
+    if text is None:
+        return 'not_requested'
+    value = candidate['identity'][field]
+    if not isinstance(value, str) or not value.strip():
+        if row.get(observed_key) is not None:
+            raise ResearchServingError('DRUG_CANDIDATE_QUERY_MISMATCH')
+        return 'source_detail_unknown'
+    if row.get(observed_key) is not True:
+        raise ResearchServingError('DRUG_CANDIDATE_QUERY_MISMATCH')
+    return 'literal_substring_observed'
+
+
+class DrugCandidateRepository(DrugIdentityRepository):
+    """Discover dated dictionary rows; exact RxCUI choice is a separate action."""
+
+    def search(self, name_text, *, strength_text=None, form_text=None, limit=MAX_PAGE,
+               after_ordinal=0, expected_snapshot_id=None, year=2026):
+        name = _text(name_text)
+        strength, form = _text(strength_text, optional=True), _text(form_text, optional=True)
+        if (type(year) is not int or year != 2026 or type(limit) is not int or not 1 <= limit <= MAX_PAGE
+                or type(after_ordinal) is not int or not 0 <= after_ordinal <= EXPECTED_DICTIONARY_ROWS
+                or expected_snapshot_id is not None and not isinstance(expected_snapshot_id, str)
+                or after_ordinal and expected_snapshot_id is None):
+            raise ResearchServingError('INVALID_LITERAL_DRUG_REQUEST')
+        selected = self.binding.selections
+        if (set(selected) != {'drug_identity'} or selected['drug_identity'].get('layer_id') != 'L05'
+                or selected['drug_identity'].get('source_table') != 'drug_identities'):
+            raise ResearchServingError('DRUG_IDENTITY_SELECTION_REQUIRED')
+        selection = selected['drug_identity']
+        name_pattern, strength_pattern, form_pattern = map(_pattern, (name, strength, form))
+        with self._read() as (connection, _base_access):
+            access = connection.execute(ACCESS, (list(SOURCE_ACCESS_IDS),)).fetchall()
+            result = self._envelope(json_safe(access))
+            snapshot_id = result['binding']['snapshot_id']
+            if expected_snapshot_id is not None and expected_snapshot_id != snapshot_id:
+                raise ResearchServingError('STALE_RESEARCH_SNAPSHOT')
+            controls = connection.execute(CONTROLS, (selection['derivation_id'],)).fetchone()
+            if controls != EXPECTED_CONTROLS:
+                raise ResearchServingError('DRUG_CANDIDATE_POPULATION_MISMATCH')
+            rows = connection.execute(SEARCH, (selection['derivation_id'], after_ordinal, name_pattern,
+                strength_pattern, strength_pattern, form_pattern, form_pattern, limit + 1,
+                name_pattern, strength_pattern, form_pattern)).fetchall()
+            if len(rows) > limit + 1:
+                raise ResearchServingError('DRUG_CANDIDATE_LOOKUP_LIMIT')
+            ordinals = [row.get('source_row_ordinal') for row in rows]
+            if (any(type(ordinal) is not int or not after_ordinal < ordinal <= EXPECTED_DICTIONARY_ROWS
+                    for ordinal in ordinals) or ordinals != sorted(set(ordinals))):
+                raise ResearchServingError('DRUG_CANDIDATE_QUERY_MISMATCH')
+            candidates = []
+            for row in rows[:limit]:
+                candidate = _candidate(row)
+                if row.get('name_literal_observed') is not True:
+                    raise ResearchServingError('DRUG_CANDIDATE_QUERY_MISMATCH')
+                lexical = {'name': 'literal_substring_observed',
+                    'strength': _field_state(row, candidate, strength, 'ingredient_strength_description',
+                                             'strength_literal_observed'),
+                    'form': _field_state(row, candidate, form, 'dose_form', 'form_literal_observed')}
+                candidate.update(discovery_basis='case_insensitive_literal_substrings',
+                    lexical_states=lexical, lookup_snapshot_id=snapshot_id,
+                    lexical_occurrence_is_not_identity_or_dose_equivalence=True,
+                    discovery_state='requires_explicit_identity_confirmation')
+                candidates.append(candidate)
+            more = len(rows) > limit
+            partial_details = any(candidate['missing_identity_details'] for candidate in candidates)
+            request = {'name_text': name, 'strength_text': strength, 'form_text': form,
+                       'year': year, 'limit': limit, 'after_ordinal': after_ordinal}
+            reasons = (['MORE_LITERAL_CANDIDATES_REMAIN'] if more else [])
+            if partial_details:
+                reasons.append('RETURNED_SOURCE_IDENTITY_DETAILS_PARTIAL')
+            registered = sorted(row['source_id'] for row in access)
+            result.update(contract_id=VERSION, lookup_kind='literal_dictionary_candidate_discovery',
+                operator_only=True, scope={'year': year, 'category': 'retained_drug_identity_dictionary',
+                    'geography': 'no_personal_geography_or_offering_scope'},
+                requested=request, query_id=digest({'contract_id': VERSION, 'snapshot_id': snapshot_id,
+                                                  'requested': request}),
+                discovery_state=('literal_candidates_require_confirmation' if candidates
+                                 else 'not_observed_in_selected_literal_query'),
+                candidates=candidates, candidate_count=len(candidates),
+                page={'has_more': more, 'next_after_ordinal': ordinals[limit - 1] if more else None,
+                      'ordering': 'source_row_ordinal', 'snapshot_id': snapshot_id},
+                partial={'is_partial': bool(more or partial_details), 'reason_codes': reasons,
+                    'source_dictionary_missing_details': {'name': controls['missing_name'],
+                        'strength': controls['missing_strength'], 'form': controls['missing_form']},
+                    'source_dictionary_is_complete_terminology': False,
+                    'optional_filters_retain_name_candidates_with_missing_source_details': True},
+                dictionary_scope={'benefit_year': 2026, 'source_table': 'drug_identities',
+                    'selected_rows': EXPECTED_DICTIONARY_ROWS, 'pack_rows': controls['pack_rows'],
+                    'offering_grain': None, 'formulary_grain': None,
+                    'terminology_currentness': 'dated_retained_source_not_reverified'},
+                source_access_registration={'state': 'registered' if registered else 'unregistered',
+                    'requested_source_ids': list(SOURCE_ACCESS_IDS), 'registered_source_ids': registered,
+                    'absence_is_permission': False, 'output_authority': 'held'},
+                automatic_profile_binding=False, consumer_release=False, personal_coverage_result=False,
+                clinical_substitution=False, clinical_or_dose_equivalence=False,
+                gaps_preserved=['G05', 'G08', 'G09', 'G11', 'G14'])
+            result['limitations'] = [
+                'Operator-only discovery over the retained 4,547-row dictionary, not a complete or current terminology service.',
+                'Case-insensitive literal substrings retrieve candidates; one result or a strength-text occurrence is not identity or dose equivalence.',
+                'Only outer query whitespace is removed; no typo correction, synonym/brand expansion, ingredient inference or unit conversion.',
+                'Source strength/form omissions remain unknown even when the name contains apparent details; packs are not decomposed.',
+                'Optional strength/form filters retain name candidates whose corresponding source attribute is missing, explicitly unresolved.',
+                'A missing literal result is unknown within this selection; it is not absence of coverage, a clinical finding or a suggested substitute.',
+                'Exact RxCUI selection and item/report-specific confirmation are separate actions; no customer item is bound here.',
+                'The dictionary has no offering/formulary membership, quantity, pharmacy, price or personal approval grain.',
+                'Source access, evidence/method acceptance and consumer-purpose release remain held independently of discovery.',
+            ]
+            safe = json_safe(result)
+            if len(json.dumps(safe, ensure_ascii=False).encode()) > MAX_RESPONSE_BYTES:
+                raise ResearchServingError('DRUG_CANDIDATE_RESPONSE_LIMIT')
+            return safe
+
+
+def candidate_repository_from_env(*, repository_root, dsn=None, timeout_ms=5000):
+    """Reuse the immutable physical-target, source, job and reader-role checks."""
+    base = repository_from_env(repository_root=repository_root, dsn=dsn, timeout_ms=timeout_ms)
+    binding = load_local_binding(repository_root, selection=SELECTION)
+    return DrugCandidateRepository(base._connection_factory, binding, timeout_ms=timeout_ms)
diff --git a/infrastructure/daylight-data/src/daylight_data/serving/identity.py b/infrastructure/daylight-data/src/daylight_data/serving/identity.py
new file mode 100644
index 0000000..21e315f
--- /dev/null
+++ b/infrastructure/daylight-data/src/daylight_data/serving/identity.py
@@ -0,0 +1,175 @@
+"""Operator-only exact RxCUI candidates from the retained L05 dictionary.
+
+No name search, clinical substitution, NDC conversion, offering/coverage join or
+customer binding. A dictionary ID match remains an inspectable source candidate;
+it establishes no current terminology status, participation, coverage or release.
+"""
+import copy
+import json
+import re
+
+from .binding import ResearchServingError, digest, load_local_binding
+from .repository import ResearchPlanRepository, STATE_KEYS, json_safe, repository_from_env
+
+
+VERSION = 'l05-exact-rxcui-research-r1'
+SELECTION = {'drug_identity': ('L05', 'drug_identities', '/build-r3/')}
+EXPECTED_DICTIONARY_ROWS = 4547
+MAX_IDS = 20
+MAX_RECORDS = 100
+RXCUI = re.compile(r'[1-9][0-9]{0,9}\Z')
+CONCEPT_TYPES = {'SCD', 'SBD', 'GPCK', 'BPCK'}
+SOURCE_ACCESS_IDS = ('sealed-local:L05', 'L05')
+
+CONTROLS = """SELECT count(*) AS rows,min(benefit_year) AS min_year,
+ max(benefit_year) AS max_year,count(offering_id) AS offering_rows
+ FROM dl_evidence.observation
+ WHERE derivation_id=%s AND entity_type='drug_product' AND source_table='drug_identities'"""
+
+# observation_pkey first bounds the read to this exact 4,547-row derivation and
+# entity type. The JSON equality predicate does not claim a dedicated RxCUI
+# index; source_record_pkey supplies the exact raw-parent lookup. No global scan.
+EXACT_RXCUI = """WITH matched AS MATERIALIZED (
+ SELECT * FROM dl_evidence.observation
+ WHERE derivation_id=%s AND entity_type='drug_product' AND source_table='drug_identities'
+ AND fields->>'rxcui'=ANY(%s) ORDER BY source_row_ordinal LIMIT 101)
+ SELECT o.*,r.raw_payload,r.raw_sha256,r.record_id,r.source_row_key,r.ordinal_basis,
+ d.snapshot_id,d.adapter_code_sha256,s.original_path,s.artifact_sha256,
+ s.source_use_state AS snapshot_source_use_state
+ FROM matched o
+ JOIN dl_evidence.source_record r USING(derivation_id,source_table,source_row_ordinal)
+ JOIN dl_control.derivation d USING(derivation_id)
+ JOIN dl_control.source_snapshot s USING(snapshot_id)
+ ORDER BY o.source_row_ordinal"""
+
+ACCESS = """SELECT source_id,state,reason,updated_at FROM dl_control.source_access_state
+ WHERE source_id=ANY(%s) ORDER BY source_id"""
+
+
+def _candidate(row):
+    fields, raw = row.get('fields'), row.get('raw_payload')
+    if not isinstance(fields, dict) or not isinstance(raw, dict):
+        raise ResearchServingError('DRUG_IDENTITY_LINEAGE_MISMATCH')
+    payload = raw.get('payload')
+    try:
+        payload = json.loads(payload) if isinstance(payload, str) else payload
+    except (TypeError, ValueError):
+        raise ResearchServingError('DRUG_IDENTITY_LINEAGE_MISMATCH') from None
+    cui = fields.get('rxcui')
+    if (not isinstance(payload, dict) or not isinstance(cui, str) or not RXCUI.fullmatch(cui)
+            or raw.get('rxcui') != cui or payload.get('rxcui') != cui
+            or row.get('raw_sha256') != digest(raw)
+            or row.get('record_id') != digest([row.get('snapshot_id'), row.get('source_table'), row.get('source_row_ordinal')])
+            or row.get('entity_id') != 'L05:' + row.get('record_id', '')
+            or row.get('benefit_year') != 2026 or row.get('offering_id') is not None
+            or fields.get('concept_type') not in CONCEPT_TYPES
+            or fields.get('concept_type') != payload.get('type')
+            or fields.get('coverage_inferred') is not False
+            or any(fields.get(key) != payload.get(native) for key, native in
+                   (('drug_name', 'name'), ('dose_form', 'dose_form'),
+                    ('ingredient_strength_description', 'ingredient_strength_description'),
+                    ('related_brand', 'related_brand')))):
+        raise ResearchServingError('DRUG_IDENTITY_LINEAGE_MISMATCH')
+    missing = [key for key in ('drug_name', 'dose_form', 'ingredient_strength_description')
+               if not isinstance(fields.get(key), str) or not fields[key].strip()]
+    pack = fields['concept_type'] in {'GPCK', 'BPCK'}
+    reasons = (['PACK_CONCEPT_NOT_SINGLE_PRODUCT'] if pack else [])
+    if missing:
+        reasons.append('SOURCE_IDENTITY_DETAILS_PARTIAL')
+    return {
+        'candidate_id': row['entity_id'], 'namespace': 'retained_L05_RxCUI_dictionary',
+        'identity': {key: copy.deepcopy(fields.get(key)) for key in
+                     ('rxcui', 'drug_name', 'dose_form', 'ingredient_strength_description',
+                      'related_brand', 'concept_type')},
+        'identity_grain': 'pack_concept' if pack else 'drug_product_concept',
+        'identity_detail_state': 'partial' if missing else 'source_details_present',
+        'missing_identity_details': missing, 'reason_codes': reasons,
+        'source_locator': copy.deepcopy(payload.get('source')),
+        'source_history': copy.deepcopy(payload.get('history')),
+        'source_native_fields': copy.deepcopy(fields), 'raw_source_payload': copy.deepcopy(raw),
+        'conditions': copy.deepcopy(row['conditions']),
+        'states': {key: row[key] for key in STATE_KEYS},
+        'snapshot_source_use_state': row.get('snapshot_source_use_state'),
+        'lineage': {key: row.get(key) for key in
+                    ('derivation_id', 'snapshot_id', 'artifact_sha256', 'original_path',
+                     'source_table', 'source_row_ordinal', 'source_row_key', 'ordinal_basis',
+                     'raw_sha256', 'record_id', 'adapter_code_sha256')},
+        'offering_grain': None, 'coverage_inferred': False,
+        'automatic_profile_binding': False, 'requires_identity_confirmation': True,
+        'current_terminology_status_verified': False, 'output_authority': 'held',
+    }
+
+
+class DrugIdentityRepository(ResearchPlanRepository):
+    """Exact source candidates behind the existing ownership/read-only guard."""
+
+    def lookup_rxcuis(self, rxcuis, *, year=2026, expected_snapshot_id=None):
+        if (type(year) is not int or year != 2026 or not isinstance(rxcuis, (tuple, list))
+                or not 1 <= len(rxcuis) <= MAX_IDS
+                or any(not isinstance(value, str) or not RXCUI.fullmatch(value) for value in rxcuis)
+                or len(set(rxcuis)) != len(rxcuis)
+                or expected_snapshot_id is not None and not isinstance(expected_snapshot_id, str)):
+            raise ResearchServingError('INVALID_EXACT_RXCUI_REQUEST')
+        selection = self.binding.selections.get('drug_identity')
+        if not selection or selection['layer_id'] != 'L05' or selection['source_table'] != 'drug_identities':
+            raise ResearchServingError('DRUG_IDENTITY_SELECTION_REQUIRED')
+        with self._read() as (connection, _base_access):
+            own_access = connection.execute(ACCESS, (list(SOURCE_ACCESS_IDS),)).fetchall()
+            by_source = {row['source_id']: json_safe(row) for row in own_access}
+            result = self._envelope([by_source[key] for key in sorted(by_source)])
+            if expected_snapshot_id is not None and expected_snapshot_id != result['binding']['snapshot_id']:
+                raise ResearchServingError('STALE_RESEARCH_SNAPSHOT')
+            controls = connection.execute(CONTROLS, (selection['derivation_id'],)).fetchone()
+            if (controls['rows'] != EXPECTED_DICTIONARY_ROWS or controls['min_year'] != 2026
+                    or controls['max_year'] != 2026 or controls['offering_rows'] != 0):
+                raise ResearchServingError('DRUG_IDENTITY_POPULATION_MISMATCH')
+            records = connection.execute(EXACT_RXCUI, (selection['derivation_id'], list(rxcuis))).fetchall()
+            if len(records) > MAX_RECORDS:
+                raise ResearchServingError('DRUG_IDENTITY_LOOKUP_LIMIT')
+            candidates = [_candidate(row) for row in records]
+            if any(candidate['identity']['rxcui'] not in rxcuis for candidate in candidates):
+                raise ResearchServingError('DRUG_IDENTITY_QUERY_MISMATCH')
+            matches = []
+            for cui in rxcuis:
+                related = [candidate for candidate in candidates if candidate['identity']['rxcui'] == cui]
+                state = ('exact_id_candidate' if len(related) == 1 else
+                         'ambiguous_source_identity' if related else 'not_observed_in_selected_dictionary')
+                matches.append({'rxcui': cui, 'state': state,
+                                'candidate_refs': [candidate['candidate_id'] for candidate in related],
+                                'automatic_profile_binding': False,
+                                'reason_codes': (['SOURCE_IDENTITY_AMBIGUOUS'] if len(related) > 1 else
+                                                 ['SELECTED_DICTIONARY_ID_NOT_OBSERVED'] if not related else [])})
+            registered = {row['source_id'] for row in own_access}
+            result.update(
+                contract_id=VERSION, lookup_kind='exact_rxcui_dictionary', operator_only=True,
+                scope={'year': year, 'category': 'retained_drug_identity_dictionary',
+                       'geography': 'no_personal_geography_or_offering_scope'},
+                requested={'year': year, 'rxcuis': list(rxcuis)},
+                dictionary_scope={'benefit_year': 2026, 'source_table': 'drug_identities',
+                                  'selected_rows': EXPECTED_DICTIONARY_ROWS,
+                                  'offering_grain': None, 'formulary_grain': None,
+                                  'terminology_currentness': 'dated_retained_source_not_reverified'},
+                matches=matches, candidates=candidates,
+                source_access_registration={'state': 'registered' if registered else 'unregistered',
+                    'requested_source_ids': list(SOURCE_ACCESS_IDS), 'registered_source_ids': sorted(registered),
+                    'absence_is_permission': False, 'output_authority': 'held'},
+                automatic_profile_binding=False, personal_coverage_result=False,
+                consumer_release=False, clinical_substitution=False,
+                gaps_preserved=['G05', 'G08', 'G09', 'G11', 'G14'],
+            )
+            result['limitations'] = [
+                'Internal identity research only; no accepted consumer purpose or current terminology guarantee.',
+                'Exact RxCUI dictionary candidates need item-specific confirmation; no customer item is bound here.',
+                'No free-text name search, brand substitution, pack decomposition, dose inference or NDC conversion.',
+                'A missing dictionary ID is unknown within this selection; it is not absence of coverage or a negative clinical finding.',
+                'Strength/form/history retain missing and dated source states; names are not parsed to fill them.',
+                'The dictionary has no offering/formulary membership, quantity, pharmacy, price or personal approval grain.',
+            ]
+            return json_safe(result)
+
+
+def identity_repository_from_env(*, repository_root, dsn=None, timeout_ms=5000):
+    """Reuse physical DB identity and immutable source/job checks; no discovery."""
+    base = repository_from_env(repository_root=repository_root, dsn=dsn, timeout_ms=timeout_ms)
+    binding = load_local_binding(repository_root, selection=SELECTION)
+    return DrugIdentityRepository(base._connection_factory, binding, timeout_ms=timeout_ms)
