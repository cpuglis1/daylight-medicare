+"""Read-only research bridge. Research identities never grant consumer authority.
+
+This dependency is installed explicitly by the local operator. No customer values,
+names, ZIPs, medicines or providers are sent to PostgreSQL: only the exact supported
+catalog scope is queried. The ordinary conversation remains independent of it.
+"""
+from __future__ import annotations
+
+import copy
+
+from comparison_evidence import EvidenceSnapshot
+
+
+RESEARCH_SCOPE = {'year': 2026, 'state': 'FL', 'county_fips': '12021',
+                  'category': 'medicare_advantage'}
+RESEARCH_BRIDGE_VERSION = 'advisor-postgres-research-20261101-r1'
+
+
+def validate_research_scope(scope):
+    if type(scope) is not dict or scope != RESEARCH_SCOPE:
+        raise ValueError('UNSUPPORTED_RESEARCH_SCOPE')
+    # bool is an int subclass, but is not an evidence year.
+    if type(scope.get('year')) is not int:
+        raise ValueError('UNSUPPORTED_RESEARCH_SCOPE')
+    return copy.deepcopy(RESEARCH_SCOPE)
+
+
+class RepositoryEvidenceSource:
+    """A bounded server dependency, not a JSON/client-constructed authority."""
+
+    def __init__(self, repository):
+        self.repository = repository
+
+    def snapshot(self, scope):
+        validate_research_scope(scope)
+        plans, after, binding = [], None, None
+        for _ in range(5):
+            page = self.repository.list_plans(
+                scope, after_ordinal=after, limit=20,
+                expected_snapshot_id=binding['snapshot_id'] if binding else None)
+            if page.get('status') != 'research_only':
+                raise RuntimeError('RESEARCH_BOUNDARY_MISMATCH')
+            if binding is not None and binding != page['binding']:
+                raise RuntimeError('RESEARCH_SNAPSHOT_CHANGED')
+            binding = copy.deepcopy(page['binding'])
+            if binding.get('accepted_release_id') is not None:
+                raise RuntimeError('RESEARCH_BOUNDARY_MISMATCH')
+            plans.extend(page['plans'])
+            if not page['page']['has_more']:
+                break
+            next_after = page['page']['next_after_ordinal']
+            if type(next_after) is not int or after is not None and next_after <= after:
+                raise RuntimeError('RESEARCH_CURSOR_INVALID')
+            after = next_after
+        else:
+            raise RuntimeError('RESEARCH_POPULATION_LIMIT')
+        if len(plans) != page['total'] or len(plans) > 100:
+            raise RuntimeError('RESEARCH_POPULATION_MISMATCH')
+        units = []
+        for plan in plans:
+            units.append({
+                'unit_id': plan['offering_id'], 'kind': 'cms_offering',
+                'display_name': plan['display_name'],
+                'identity': copy.deepcopy(plan['identity']),
+                'identity_state': 'source_observed_research_only',
+                'period': {'year': scope['year']}, 'role': 'medical_plan',
+                'source_refs': [copy.deepcopy(plan['lineage'])],
+                'restrictions': copy.deepcopy(plan.get('restrictions', [])),
+                'evaluation_state': 'held', 'fictional': False,
+            })
+        return EvidenceSnapshot(
+            manifest_id=binding['snapshot_id'],
+            serving_build_id=RESEARCH_BRIDGE_VERSION,
+            research_build_id=binding['build_id'], source_kind='research_held',
+            completeness='partial', units=tuple(units))
+
+
+def local_repository():
+    """Explicit local-only operator entry point; never discover app secrets."""
+    import getpass
+    from pathlib import Path
+    import sys
+
+    root = Path(__file__).resolve().parents[2]
+    package = root / 'infrastructure/daylight-data'
+    sys.path.insert(0, str(package / 'src'))
+    from daylight_data.serving import repository_from_env
+
+    # The checked operating runbook uses this existing private Unix socket.
+    # The repository independently verifies DB/OID/cluster/build before reads.
+    dsn = ('host=' + str(package / '.state/socket') +
+           ' port=55485 dbname=daylight_research_2026_r2 user=' + getpass.getuser())
+    return repository_from_env(repository_root=root, dsn=dsn)
diff --git a/alternatives/advisor-first/comparison_service.py b/alternatives/advisor-first/comparison_service.py
new file mode 100644
index 0000000..ec92fb9
--- /dev/null
+++ b/alternatives/advisor-first/comparison_service.py
@@ -0,0 +1,137 @@
+"""Private comparison view over the existing advisor records.
+
+No store, model call, public catalog, or acceptance promotion lives here. The
+conversation owns input validation/ownership and remains the question router.
+"""
+from __future__ import annotations
+
+import copy
+import logging
+
+from comparison_profile import build_comparison_profile
+from comparison_engine import build_comparison
+from comparison_evidence import PURPOSES, canonical_sha256
+from comparison_case import prepare_case
+
+
+LOGGER = logging.getLogger(__name__)
+SERVICE_VERSION = 'advisor-comparison-service-20261101-r2'
+PUBLIC_HOLD_CODES = frozenset({
+    'EXACT_RELEASE_REQUIRED', 'POLICY_NOT_ACCEPTED', 'SOURCE_MISSING',
+    'ITEM_IDENTITY_UNRESOLVED', 'CONDITION_UNRESOLVED', 'BASELINE_INCOMPLETE',
+    'DEPENDENCY_STALE', 'COMPARISON_UNAVAILABLE',
+})
+
+
+def _held_authority(reason):
+    return {purpose: {'state': 'held', 'authority_refs': [],
+                      'accepted_release_id': None, 'reason_codes': [reason]}
+            for purpose in PURPOSES}
+
+
+class ComparisonService:
+    def __init__(self, *, evidence_source=None):
+        # This is a server dependency, never a field supplied by an HTTP client.
+        self.evidence_source = evidence_source
+
+    def evaluate(self, guide, record, *, next_question=None, generated_at=None,
+                 requested_scope=None):
+        profile = build_comparison_profile(guide, record, requested_scope=requested_scope)
+        result = build_comparison(
+            profile, evidence_source=self.evidence_source,
+            generated_at=generated_at,
+            eligible_questions=[copy.deepcopy(next_question)] if next_question else [],
+        )
+        result['service_version'] = SERVICE_VERSION
+        result['case_preparation'] = prepare_case(profile, result)
+        result['binding']['case_method_version'] = result['case_preparation']['method_version']
+        digest = canonical_sha256({'structural_comparison': result['comparison_id'],
+            'binding': result['binding'], 'case_preparation': result['case_preparation'],
+            'service_version': SERVICE_VERSION})
+        result['comparison_id'] = 'comparison:' + digest
+        result['decision_record_ref'] = 'decision:' + digest
+        result['decision_record']['case_preparation_sha256'] = canonical_sha256(result['case_preparation'])
+        return result
+
+    def attach(self, response, *, historical=False, replay=False):
+        """Rebind after capture/composition and on replay, without model work."""
+        assessment = response['assessment']
+        previous = response.get('comparison') or {}
+        try:
+            comparison = self.evaluate(
+                response['guide'], response['record'],
+                next_question=assessment.get('nextQuestion'),
+                generated_at=previous.get('generated_at'),
+            )
+        except (ValueError, TypeError, KeyError, RuntimeError, OSError):
+            # A failed optional derived view cannot discard an accepted report.
+            # Logs contain a fixed diagnostic only, never the exception payload.
+            LOGGER.warning('Daylight comparison unavailable code=COMPARISON_UNAVAILABLE')
+            comparison = {
+                'service_version': SERVICE_VERSION,
+                'status': 'unavailable',
+                'accepted_release_id': None,
+                'binding': {'accepted_release_id': None},
+                'authority': _held_authority('COMPARISON_UNAVAILABLE'),
+                'findings': [], 'tradeoffs': [], 'next_question': None,
+                'work_items': [{'type': 'comparison_service_review',
+                                'status': 'proposed_not_started',
+                                'reason_codes': ['COMPARISON_UNAVAILABLE']}],
+            }
+        changed_on_replay = bool(replay and previous and previous != comparison)
+        if historical or changed_on_replay:
+            # An old turn remains a capture receipt; its derived conclusions
+            # cannot be presented as a current comparison after a later turn.
+            comparison = copy.deepcopy(comparison)
+            comparison['status'] = 'stale_binding'
+            comparison['findings'] = []
+            comparison['tradeoffs'] = []
+            comparison['next_question'] = None
+            comparison['authority'] = _held_authority('DEPENDENCY_STALE')
+            comparison['superseded_comparison_ref'] = previous.get('comparison_id')
+            comparison['comparison_id'] = None
+            comparison['decision_record_ref'] = None
+            trace = comparison.setdefault('decision_record', {})
+            trace['selection'] = None
+            trace['finding_dependencies'] = {}
+            comparison['case_preparation'] = {
+                'state': 'stale', 'baseline_reports': [], 'assessments': [],
+                'declared_constraints': [], 'declared_scenarios': [],
+                'personal_output_state': 'held', 'reason_codes': ['DEPENDENCY_STALE']}
+            comparison['research'] = {'state': 'stale', 'retained_identity_count': None,
+                                      'consumer_evaluated_count': 0}
+            trace.pop('case_preparation_sha256', None)
+            comparison.setdefault('validity', {}).update(
+                state='stale_profile' if historical else 'stale_evidence_or_method',
+                reason_codes=['DEPENDENCY_STALE'])
+        if historical or changed_on_replay:
+            response['reply'] = ''
+            assessment['nextQuestion'] = None
+            assessment['intakePaused'] = True
+            assessment['conversationOpen'] = True
+            response.pop('advisor', None)
+            response['facts'] = []
+            response['notice'] = 'Your information is preserved. This comparison needs a fresh check.'
+            response['generated'] = {'status': 'unavailable', 'retryable': False,
+                                     'code': 'comparison_stale'}
+        response['comparison'] = comparison
+        return response
+
+    @staticmethod
+    def context_status(comparison):
+        """Public capability markers only; no extra profile values or trace.
+
+        The full owner-bound response is for the service/browser. Existing
+        natural-context permissions still determine every personal model value.
+        """
+        codes = set()
+        for item in comparison.get('work_items', []):
+            codes.update(code for code in item.get('reason_codes', [])
+                         if code in PUBLIC_HOLD_CODES)
+        return {
+            'version': SERVICE_VERSION,
+            'state': 'held',
+            'personal_findings_available': False,
+            'research_completed': False,
+            'reason_codes': sorted(codes or {'EXACT_RELEASE_REQUIRED'}),
+        }
diff --git a/alternatives/advisor-first/controller_diagnostics.py b/alternatives/advisor-first/controller_diagnostics.py
new file mode 100644
index 0000000..bec71cd
--- /dev/null
+++ b/alternatives/advisor-first/controller_diagnostics.py
@@ -0,0 +1,29 @@
+"""Value-free locations for unexpected controller failures, never request data."""
+from pathlib import Path
+import re
+import traceback
+
+
+HERE = Path(__file__).resolve().parent
+ENGINE = HERE.parent / 'chat-first' / 'cms-slice' / 'scripts'
+
+
+def unexpected_failure(error):
+    """Return only a code-defined exception class and allowlisted source lines.
+
+    Exception messages, source text, locals, payloads and identifiers must never
+    enter operational diagnostics. Keep the original exception/HTTP behavior.
+    """
+    name = type(error).__name__
+    if not re.fullmatch(r'[A-Za-z][A-Za-z0-9_]{0,63}', name):
+        name = 'Exception'
+    locations = []
+    for frame in traceback.extract_tb(error.__traceback__):
+        path = Path(frame.filename).resolve()
+        if path.parent not in {HERE, ENGINE}:
+            continue
+        if not re.fullmatch(r'[a-z_]+\.py', path.name):
+            continue
+        locations.append(f'{path.name}:{frame.lineno}')
+    return {'code': 'unexpected_exception', 'type': name,
+            'locations': ','.join(locations[-8:]) or 'unavailable'}
diff --git a/alternatives/advisor-first/conversation_claims.py b/alternatives/advisor-first/conversation_claims.py
new file mode 100644
index 0000000..f0a671b
--- /dev/null
+++ b/alternatives/advisor-first/conversation_claims.py
@@ -0,0 +1,324 @@
+"""Small, scope-aware checks for supported conversational propositions.
+
+These checks cover explicit current-coverage, application-status and provider-
+access propositions. They are not an entailment engine or a replacement for
+independent language evaluation. Unknown phrasing is not silently converted into
+a new report, authorization or verified finding.
+"""
+import re
+
+
+_COVERAGE = {
+    'original': r'\boriginal medicare\b',
+    'advantage': r'\bmedicare advantage\b',
+    'medigap': r'\bmedigap\b|\bmedicare supplement\b',
+    'drug': r'\b(?:separate|standalone|stand-alone) (?:prescription )?drug (?:plan|coverage)\b|\bpart d\b',
+    'employer': r'\b(?:current[- ]job|employer|employment|job[- ]based)\b|\b(?:through|from) (?:your |a |the )?(?:spouse.s |wife.s |husband.s )?(?:current )?(?:job|work)\b',
+    'retiree': r'\bretiree\b|\b(?:former|old) employer\b|\bretirement (?:insurance|coverage)\b',
+    'cobra': r'\bcobra\b',
+    'military': r'\b(?:tricare|va|military)\b',
+    'medicaid': r'\bmedicaid\b',
+}
+_INACTIVE = {'unknown', 'deferred', 'stale', 'tentative', 'conflicting'}
+_PERSONAL_COVERAGE_NOUN = r'(?:(?:current|present|medical|health|drug|prescription|original|medicare|advantage|employer|employment|retiree|cobra|medicaid|military|va|tricare|medigap|supplement)\s+){0,3}(?:insurance|coverage|health plan)'
+
+
+def clauses(text):
+    """Preserve a question/conditional's scope; do not join unrelated sentences."""
+    return [part.strip() for part in re.split(r'(?<=[.!?;])\s+|\n+', text.replace('’', "'")) if part.strip()]
+
+
+def current_coverage_propositions(text):
+    """Recognize affirmative personal current-coverage claims with typed values.
+
+    The subject must be the reader's actual coverage. Discussion of a possible
+    route, a question, a conditional, or an older arrangement is not such a claim.
+    """
+    result = []
+    for clause in clauses(text):
+        lower = clause.casefold()
+        if '?' in lower or re.search(r'\b(?:if|whether|suppose|previously|formerly|used to|might|could|would)\b', lower):
+            continue
+        # A possessive coverage phrase inside a generic route explanation is
+        # not the subject of an actual coverage assertion. Require that same
+        # proposition boundary before comparing its category with user reports.
+        explicit_none = re.search(r"\byou(?: currently| now)? have no (?:health )?(?:insurance|coverage)\b|\byou(?:'re| are)(?: currently| now)? uninsured\b", lower)
+        if not explicit_none and not personal_insurance_assertion(clause):
+            continue
+        personal = re.search(
+            r"\byou(?: currently| now)? (?:have|receive)\b|"
+            r"\byou(?:'re| are)(?: currently| now)? (?:covered|uninsured)\b|"
+            r'\byour ' + _PERSONAL_COVERAGE_NOUN + r'\b', lower)
+        if not personal:
+            continue
+        statement = lower[personal.start():]
+        # A future start/end, coverage question or stated preference is not a
+        # present assertion that the person has this coverage category.
+        if re.search(r'\b(?:insurance|coverage|health plan) (?:question|options?|choices?|preference|goal)\b', statement):
+            continue
+        if re.search(r'\b(?:no (?:health )?(?:insurance|coverage)|uninsured)\b', statement):
+            result.append(frozenset({'none'}))
+            continue
+        if re.search(r"\b(?:not|don't|do not|no longer)\b", statement):
+            continue  # Negated category claims need their own proposition type.
+        values = {key for key, pattern in _COVERAGE.items() if re.search(pattern, statement)}
+        if 'retiree' in values:
+            values.discard('employer')
+        if values:
+            result.append(frozenset(values))
+        elif re.search(r"\byou(?: currently| now)? (?:have|receive) (?:current |health |medical )?(?:insurance|coverage)\b|\byou(?:'re| are)(?: currently| now)? covered\b", statement):
+            result.append(frozenset({'__some_coverage__'}))
+    return result
+
+
+def coverage_matches_reports(text, referenced_reports):
+    claims = current_coverage_propositions(text)
+    if not claims:
+        return True
+    values = set()
+    for report in referenced_reports:
+        if report.get('status') in _INACTIVE:
+            continue
+        value = report.get('value')
+        if report.get('id') == 'guide.coverage.current':
+            values.update(value if isinstance(value, list) else [value] if isinstance(value, str) else [])
+        elif report.get('id', '').startswith('readiness.RC09.'):
+            if value in {'my_job', 'spouse_job', 'family_job'}:
+                values.add('employer')
+            elif value in {'cobra', 'retiree'}:
+                values.add(value)
+    return all(bool(values - {'none', 'unknown', 'deferred'}) if claim == {'__some_coverage__'}
+               else claim <= values for claim in claims)
+
+
+def personal_insurance_assertion(text):
+    """Bind coverage assertions to their personal subject, not the paragraph.
+
+    Generic category teaching stays generic even beside conversational "you".
+    A bare follow-on "Coverage is ..." can inherit only an immediately preceding
+    factual personal statement, not an invitation, hypothetical or category.
+    """
+    noun = _PERSONAL_COVERAGE_NOUN
+    factual_person = False
+    for sentence in clauses(text):
+        lower = sentence.casefold()
+        if '?' in sentence or re.match(r'\s*(?:if|suppose|whether|hypothetically)\b', lower):
+            factual_person = False
+            continue
+        direct = re.search(r"\b(?:you|they|he|she)\s+(?:(?:currently|already|now)\s+)?(?:have|has|receive|receives)\s+(?:a\s+)?" + noun + r'\b(?!\s+(?:option|choice|question)s?\b)', lower)
+        covered = re.search(r"\b(?:you|they|he|she)(?:'re| are| is| remain| remains| stay| stays)\s+(?:currently\s+)?covered\b", lower)
+        possessed = re.search(r'\b(?:your|their|his|her)\s+' + noun + r'\b(?!\s+(?:option|choice|question)s?\b)', lower)
+        if direct or covered:
+            return True
+        if possessed:
+            rest = lower[possessed.end():]
+            # Permit relative/parenthetical clauses while retaining the explicit
+            # possessive subject. Potential/conditional coverage is not actual.
+            predicate = (r'\A\s*(?:,\s*(?:which|that)\s+|,\s*[^,]{1,80},\s*)?'
+                         r'(?:(?:currently|already|now|still)\s+)?'
+                         r'(?:is|comes|ends|will|through|from|under|via|active)\b')
+            if re.search(predicate, rest) and not re.search(r'\b(?:would|could|might)\b', rest):
+                return True
+        if factual_person and re.match(r'\s*(?:the\s+)?(?:insurance|coverage|health plan)\s+(?:is|comes|ends|will)\b', lower):
+            return True
+        factual_person = bool(re.search(r"\b(?:you|they|he|she)(?:'re| are| is| have| has)\s+(?:currently\s+)?(?:retired|retiring|working|employed|enrolled|covered)\b", lower))
+    return False
+
+
+def application_status(text):
+    """Return only an asserted personal application status, never topic mention."""
+    statuses = []
+    for clause in clauses(text):
+        if '?' in clause or re.search(r'\b(?:if|whether|suppose|might|could|would)\b', clause, re.I):
+            continue
+        if re.search(r"\b(?:you|they|he|she)\s+(?:haven't|have not|hasn't|has not|never)\s+(?:yet\s+)?applied\b", clause, re.I):
+            statuses.append('not_applied')
+        elif re.search(r"\b(?:you|they|he|she)(?:'ve| have| has)?\s+(?:already\s+)?(?:applied|submitted (?:your |their |an? |the )?application)\b|\byour application\s+(?:is|has been|was)\s+(?:pending|submitted|received)\b", clause, re.I):
+            statuses.append('pending')
+    return statuses
+
+
+def provider_access_supported(text, evidence):
+    """Check evidence topic and preserved scope for explicit provider-access claims.
+
+    A general Medicare definition cannot support a statement about doctor access.
+    Universal doctor access is not an authorized Advantage proposition; Original
+    Medicare's public proposition retains the accepts-Medicare qualification.
+    This is deliberately a bounded claim family, not general source entailment.
+    """
+    for clause in clauses(text):
+        if '?' in clause:
+            continue
+        lower = clause.casefold()
+        # Bind the asserted subject before considering incidental route names,
+        # such as "Unlike Medicare Advantage, Original Medicare lets ...".
+        subject = re.search(r'\b(original medicare|medicare advantage)(?: plans?)?'
+            r'(?:\s+(?:generally|typically|usually|often|can|may|does|not))*\s+'
+            r'(?:covers?|lets?|allows?|provides?|accepts?|has|is)\b', lower)
+        mentioned = {kind for name, kind in [('medicare advantage', 'advantage'),
+                     ('original medicare', 'original')] if name in lower}
+        route = (('advantage' if subject[1] == 'medicare advantage' else 'original') if subject
+                 else next(iter(mentioned)) if len(mentioned) == 1 else None)
+        if not route or not re.search(r'\b(?:doctors?|providers?|hospitals?|networks?)\b', lower):
+            continue
+        if not re.search(r'\b(?:covers?|accepts?|access|see|use|choose|networks?|vary|varies|limited|restrict\w*)\b', lower):
+            continue
+        # Pure research/process language does not claim the access result.
+        if re.search(r'\b(?:compare|check|discuss|ask about|look at)\b', lower) and not re.search(r'\b(?:covers?|accepts?|can see|can use)\b', lower):
+            continue
+        supporting = [item for item in evidence
+                      if re.search(r'\b(?:doctors?|providers?|hospitals?|networks?)\b', item.get('text', ''), re.I)
+                      and (('medicare advantage' in item.get('text', '').casefold() or item.get('id') == 'advantage')
+                           if route == 'advantage' else
+                           ('original medicare' in item.get('text', '').casefold() or item.get('id') in {'original', 'parts'}))]
+        if not supporting:
+            return False
+        universals = list(re.finditer(r'\b(?:every|any|all) (?:u\.s\. )?(?:doctors?|providers?|hospitals?)\b|\bno (?:network )?restrictions\b', lower))
+        # Negation must govern this access predicate/quantifier. A different
+        # proposition such as "is not free and covers every doctor" cannot
+        # weaken the universal-access guard.
+        negative_access = re.compile(
+            r"(?:\bnot\s+|\b(?:does not|do not|doesn't|don't|cannot|can't|will not|won't|not)\s+"
+            r"(?:(?:necessarily|always|automatically|universally)\s+)?"
+            r"(?:(?:cover|accept|include|see|use|choose|have)\s+|"
+            r"(?:let|allow)\s+you\s+(?:to\s+)?(?:see|use|choose)\s+))\Z")
+        unqualified_universal = any(not negative_access.search(lower[:match.start()]) for match in universals)
+        if unqualified_universal:
+            if route == 'advantage' or not re.search(r'\b(?:accepts?|takes?|participat\w* in) medicare\b', lower):
+                return False
+    return True
+
+
+def question_scope_valid(text, question):
+    """Check atomic request shape and the supported coverage/prescription scopes.
+
+    Coupled fields in an approved question remain coupled. The remaining
+    question meanings retain the caller's existing guards; this is not a claim
+    of exhaustive semantic verification for all 41 meanings.
+    """
+    identifier = question.get('canonical_id', question.get('id'))
+    fields = question.get('fields', [])
+    allowed_requests = max(1, question.get('atomicRequests', 1), len(fields))
+    requests = max(text.count('?'), 1 + len(re.findall(
+        r'\b(?:and|also)\s+(?:what|which|when|where|who|how|do you|are you)\b', text, re.I)))
+    if requests > allowed_requests:
+        return False
+    if identifier == 'T07':
+        subject = re.sub(r'\b(?:prescription(?: drug)?|drug) (?:coverage|plans?|insurance)\b', '', text, flags=re.I)
+        return bool(re.search(r'\b(?:prescriptions?|medicines?|medications?|meds|drugs?)\b', subject, re.I))
+    return True
+
+
+def personal_intake_question(text):
+    """Recognize direct requests for personal coverage/medicine/timing reports.
+
+    Educational invitations (what would help, shall we explore, how does X work)
+    remain free. A detected intake request needs an explicit approved target;
+    the service does not guess that target from this wording.
+    """
+    for clause in clauses(text):
+        lower = clause.casefold()
+        if re.match(r'(?:would you like|want me to|should we|shall we)\b', lower) or re.search(r'\b(?:help (?:you )?understand|help clarify)\b', lower):
+            continue
+        if re.search(r'\b(?:what|which|when|where|whose|how much|how many|do you|are you|have you|did you|tell me|tell us)\b', lower) and re.search(
+                r'\b(?:you (?:currently |already |now )?(?:have|take|use|live|pay|retir\w*|work\w*|enrol\w*|appl\w*)|your (?:current )?(?:insurance|coverage|prescriptions?|medicines?|medications?|doctors?|birthday|job|zip|income|premium))\b', lower):
+            return True
+        if re.search(r'\b(?:what|which)\s+(?:[a-z]+\s+){0,2}(?:doctors?|hospitals?|prescriptions?|medicines?|medications?|meds)\b.{0,100}\b(?:you|your|we include)\b|\bhow old are you\b', lower):
+            return True
+    return False
+
+
+def explicit_defer_request(quote):
+    """A present request to postpone this detail, not a hypothetical or refusal."""
+    for clause in clauses(quote):
+        if re.search(r"\b(?:if|suppose|hypothetically|used to|don't|do not|not)\b", clause, re.I):
+            continue
+        if re.search(r'\b(?:leave|save|keep|hold)\b.{0,100}\b(?:for later|until later|for another time)\b|\b(?:come|go|get) back to\b.{0,100}\blater\b', clause, re.I):
+            return True
+    return False
+
+
+def named_defer_targets(quote):
+    """Named question objects in a present postponement request.
+
+    These aliases identify approved meanings, not new profile fields. Mentions
+    in an adjacent educational question do not determine the postponed target.
+    """
+    found = set()
+    for clause in clauses(quote):
+        if not explicit_defer_request(clause):
+            continue
+        if re.search(r'\b(?:job|employment|medicine|medication|prescription) start[- ](?:month|date)\b', clause, re.I):
+            # An embedded start-date alias is not the coverage-start meaning.
+            # This sentinel can only reject a mismatched disposition; it never
+            # creates or routes to an unapproved field.
+            found.add('non_coverage_start')
+        elif re.search(r'\b(?:start[- ]month|start[- ]date|(?:desired|coverage) start)(?:\s+question)?\b', clause, re.I):
+            found.add('T04')
+        if re.search(r'\b(?:doctor|provider|hospital)(?:s| names?| list)?\s+questions?\b', clause, re.I):
+            found.add('T06')
+        if re.search(r'\b(?:prescription|medicine|medication)(?:s| names?| list)?\s+questions?\b', clause, re.I):
+            found.add('T07')
+    return found
+
+
+_START_QUESTION = r'(?:start[- ]month|start[- ]date|(?:desired|coverage) start)(?:\s+question)?'
+_START_OBJECT = r'(?:(?:the|my|our|this|that)\s+)?' + _START_QUESTION
+_REQUEST_PREFIX = r"(?:(?:please|let's|let us|can we|could we|I(?:'d| would) like to)\s+)?"
+_START_DEFERRAL = re.compile(
+    r'\A\s*' + _REQUEST_PREFIX + r'(?:'
+    r'(?:leave|save|keep|hold)\s+' + _START_OBJECT + r'\s+(?:for later|until later|for another time)'
+    r'|(?:come|go|get) back to\s+' + _START_OBJECT + r'\s+later'
+    r')\s*[.!?;]?\s*\Z', re.I)
+
+
+def explicit_named_start_deferral(message):
+    """One bounded conversation control, independent of extraction labels.
+
+    Match a complete leading current request, preserving its exact original
+    quote. Never search an inner phrase of quoted/attributed speech, a conditional,
+    or an employment/medicine start question. A second mention of this target
+    leaves its current intention ambiguous and remains semantic interpretation.
+    This creates only a conversational disposition, never a date or other fact.
+    """
+    if not isinstance(message, str):
+        return None
+    parts = [part.strip() for part in re.split(r'(?<=[.!?;])\s+|\n+', message) if part.strip()]
+    if (not parts or not _START_DEFERRAL.fullmatch(parts[0].replace('’', "'"))
+            or any(re.search(_START_QUESTION, part, re.I) for part in parts[1:])):
+        return None
+    return {'id':'T04', 'entity':'profile', 'fields':[{'key':'choice','value':'deferred'}],
+            'quote':parts[0], 'scope':'intended', 'subject':'beneficiary',
+            'uncertain':False, 'correction':False}
+
+
+def canonical_named_start_deferral(update, message):
+    """Correct a disposition-only proposal for an independently explicit control."""
+    if (not isinstance(update, dict) or update.get('entity') != 'profile'
+            or update.get('subject') != 'beneficiary' or update.get('scope') not in {'current', 'intended'}
+            or update.get('fields') not in ([{'key':'choice','value':'later'}],
+                                          [{'key':'choice','value':'deferred'}],
+                                          [{'key':'choice','value':'check later'}],
+                                          [{'key':'choice','value':'unknown'}],
+                                          [{'key':'choice','value':'not sure'}])):
+        return None
+    control = explicit_named_start_deferral(message)
+    if control is None or update.get('quote') != control['quote']:
+        return None
+    return {**update, **control}
+
+
+def normalize_named_start_deferral(updates, message):
+    """Merge the explicit navigation control before ordinary report validation.
+
+    Omission or a mislabeled disposition cannot change the control's meaning.
+    Only disposition proposals for its exact clause are replaced. Other fields,
+    quotes and reports retain their original validators and the 24-update bound.
+    """
+    control = explicit_named_start_deferral(message)
+    if control is None:
+        return updates
+    remaining = [update for update in updates if canonical_named_start_deferral(update, message) is None]
+    if len(remaining) >= 24:
+        return updates
+    return [*remaining, control]
diff --git a/alternatives/advisor-first/decision_guidance.py b/alternatives/advisor-first/decision_guidance.py
new file mode 100644
index 0000000..33bfbc3
--- /dev/null
+++ b/alternatives/advisor-first/decision_guidance.py
@@ -0,0 +1,109 @@
+"""Small decision brief from already permitted state; never profile authority.
+
+This ranks eligible questions rather than adding questions, personal findings,
+saved discourse, or model stages. An educational detour may end without an ask.
+"""
+import copy
+
+
+OBJECTIVES = {
+    'timing': 'Understand which coverage and enrollment facts matter to the timing decision.',
+    'current_coverage': 'Understand the current coverage situation before discussing a change.',
+    'doctors': 'Understand the access tradeoff and what an exact provider check would require.',
+    'drugs': 'Understand how medicine coverage fits and what a supported medicine check needs.',
+    'travel': 'Understand how using care away from home affects the coverage-path discussion.',
+    'total_cost': 'Understand the cost tradeoff and distinguish published amounts from personal totals.',
+    'bills': 'Understand costs when using care and which amounts remain unverified.',
+    'flexibility': 'Understand future flexibility and the conditions that still need checking.',
+    'learning': 'Resolve the current explanation need at the requested depth.',
+    'coverage_paths': 'Understand the coverage-path distinction relevant to the person’s concern.',
+    'other': 'Clarify the stated concern and identify one useful supported next step.',
+}
+QUESTION_FOCUS = {
+    'timing': ('T05', 'RC09', 'RC04', 'RC05', 'RC06', 'RC08', 'RC10', 'RC11',
+               'RC11.C1', 'RC12', 'RC13', 'RC26', 'RC27', 'T04'),
+    'current_coverage': ('T05', 'RC09', 'RC04', 'RC10', 'RC11', 'RC12', 'RC13'),
+    'doctors': ('T06', 'RC21', 'T08', 'RC20', 'T10'),
+    'drugs': ('T07', 'RC22', 'RC23', 'RC24', 'T09'),
+    'travel': ('T08', 'RC20', 'T06', 'T10'),
+    'total_cost': ('T09', 'RC25', 'RC14', 'RC15', 'RC16', 'T10'),
+    'bills': ('T09', 'RC25', 'T10'),
+    'flexibility': ('T05', 'RC04', 'RC05', 'RC26', 'RC27', 'T10'),
+    'coverage_paths': ('T05', 'T10', 'T06', 'T08', 'T07', 'T09'),
+    'learning': ('T02',),
+    'other': ('T10',),
+}
+TASK_FOCUS = {'timing': 'timing', 'providers': 'doctors', 'drug_coverage': 'drugs',
+              'drug_pricing': 'drugs', 'costs': 'total_cost', 'medigap': 'flexibility',
+              'learn': 'learning', 'compare': 'coverage_paths', 'review': 'coverage_paths'}
+CONCEPT_FOCUS = {'enrollment_timing': 'timing', 'current_coverage_timing': 'timing',
+    'provider_checks': 'doctors', 'medicine_checks': 'drugs',
+    'prescription_coverage': 'drugs', 'cost_components': 'total_cost',
+    'medical_spending_limits': 'bills', 'medigap_switching': 'flexibility',
+    'coverage_paths': 'coverage_paths', 'original_medicare': 'coverage_paths',
+    'medicare_advantage': 'coverage_paths', 'medigap': 'coverage_paths'}
+
+
+def guidance(candidates, *, task='', concerns=(), age65=False,
+             dispositions=None, pending_question=None, education_request=None):
+    """Return independent candidate copies and a bounded, non-authoritative brief.
+
+    education_request must already have current-message quote and concept checks.
+    The same approved candidates remain selectable; relevance is not a new gate.
+    """
+    request = education_request or {}
+    concepts = request.get('concept_ids', [])
+    open_concerns = [item for item in concerns if item.get('status') == 'open'
+                     and item.get('subject') == 'beneficiary'
+                     and item.get('topic') in OBJECTIVES]
+    practical_focus = open_concerns[-1]['topic'] if open_concerns else TASK_FOCUS.get(task, 'coverage_paths')
+    if not open_concerns and age65 and task in {'', 'compare', 'timing'}:
+        practical_focus = 'timing'
+    # A user's direct learning request takes conversational precedence without
+    # reordering personal intake or converting learner curiosity into a
+    # beneficiary priority. The explanation's focus and its practical return
+    # point are distinct; all approved candidates remain selectable.
+    focus = practical_focus
+    if request.get('kind') in {'explain', 'clarify', 'revisit'} and concepts:
+        focus = CONCEPT_FOCUS.get(concepts[0], 'learning')
+    relevant = QUESTION_FOCUS[practical_focus]
+    ranked = copy.deepcopy(candidates)
+    for item in ranked:
+        identifier = item['question']['id']
+        item['decision_relevance'] = ('clarification' if item.get('required') else
+            'current_decision' if identifier in relevant else
+            'return_point' if identifier == pending_question else 'available_if_useful')
+    def order(item):
+        identifier = item['question']['id']
+        # A person/ambiguity dependency retains precedence. Within a current
+        # decision, prefer factual dependencies before an unexplained preference.
+        if item.get('required') or identifier == 'RC01':
+            return (0, item.get('priority', 1), 0)
+        if identifier in relevant:
+            return (1, relevant.index(identifier), item.get('priority', 1))
+        if identifier == pending_question:
+            return (2, 0, 0)
+        return (3, item.get('priority', 1), 0)
+    ranked.sort(key=order)
+    obstacles = []
+    for identifier, state in (dispositions or {}).items():
+        if identifier in relevant and state in {'unknown', 'deferred', 'conflicting'}:
+            help_text = ('Help explain the decision; do not demand a preferred month.'
+                         if identifier == 'T04' and state == 'unknown' else
+                         'Leave this open unless the person reopens it.' if state == 'deferred' else
+                         'Preserve uncertainty; clarify only when needed for this concern.')
+            obstacles.append({'question_id': identifier, 'state': state, 'help': help_text})
+    if not obstacles:
+        next_item = next((item for item in ranked if item.get('required') or
+                          item['question']['id'] in relevant), None)
+        if next_item:
+            obstacles.append({'question_id': next_item['question']['id'],
+                'state': 'conflicting' if next_item.get('required') else 'missing',
+                'help': 'Ask only if its answer changes the useful help available now.'})
+    kind = request.get('kind')
+    policy = ('clarify_current_confusion' if kind == 'clarify' else
+              'answer_first_return_when_useful' if kind in {'explain', 'revisit'} else
+              'choose_consequential_question')
+    return ranked, {'focus': focus, 'practical_focus': practical_focus, 'objective': OBJECTIVES[focus],
+                    'obstacles': obstacles[:4], 'question_policy': policy,
+                    'return_point_is_optional': True, 'personal_research': 'held'}
diff --git a/alternatives/advisor-first/education.py b/alternatives/advisor-first/education.py
