+        for segment in rest:
+            if segment.endswith('[]'):
+                key = segment[:-2]
+                values = value.get(key, []) if isinstance(value, dict) else []
+                tail = '.'.join(rest[rest.index(segment) + 1:])
+                return bool(values) if not tail else any(_path_exists({'reports': {'X': item}}, 'reports.X.' + tail) for item in values)
