+                    'quote':{'type':'string','maxLength':360},
+                    'subject':{'type':'string','enum':['beneficiary','learner','unclear']},
+                    'scope':{'type':'string','enum':['current','intended','historical','unknown']}})}),
+            'situation_proposals':{'type':'array','maxItems':4,'items':schema({
