      : `
          <li><a href="#${anchor('formularychanges')}" class="quick-link pharmacy-jump-link">Formulary Changes</a></li>
          <li><a href="#${anchor('m3p')}" class="quick-link pharmacy-jump-link">Medicare Prescription Payment Plan (M3P)</a></li>`;

    return `
