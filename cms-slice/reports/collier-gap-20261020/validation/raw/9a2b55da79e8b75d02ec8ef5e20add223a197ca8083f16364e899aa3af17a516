    link.addEventListener('click', handleLinkClick);
  });
}

  container.addEventListener('click', function (event) {
    if (event.target && event.target.matches('button[id^="print"]')) {
      printContent();
    }
  });

  function printContent() {
    const restorepage = document.body.innerHTML;
    const printcontent = document.getElementById('medsform').cloneNode(true);
    document.body.innerHTML = '';
    document.body.appendChild(printcontent);
    document.getElementById('medsform').style.display = 'block';
    window.print();
    document.body.innerHTML = restorepage;
    window.location.reload();
  }

  const PHARMACY_SCROLL_OFFSET = 300;

  function scrollToPharmacyTarget(target) {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        const top =
          target.getBoundingClientRect().top +
          window.pageYOffset -
          PHARMACY_SCROLL_OFFSET;

        window.scrollTo({
          top: Math.max(0, top),
          behavior: 'smooth'
        });

        if (!target.hasAttribute('tabindex')) {
          target.setAttribute('tabindex', '-1');
          target.dataset.pharmacyTemporaryTabindex = 'true';
        }

        target.focus({ preventScroll: true });
      });
    });
  }

  function openAccordionForHash(hash = window.location.hash) {
    if (!hash) return;

    const target = document.getElementById(hash.replace(/^#/, ''));
    if (!target) return;

    const revealTarget = () => {
      scrollToPharmacyTarget(target);
    };

    const openContainingAccordion = () => {
      const collapse = target.closest('.accordion-collapse');

      if (!collapse || !window.bootstrap || !bootstrap.Collapse) {
        revealTarget();
        return;
      }

      if (collapse.classList.contains('show')) {
        revealTarget();
        return;
      }

      collapse.addEventListener(
        'shown.bs.collapse',
        revealTarget,
        { once: true }
      );

      bootstrap.Collapse
        .getOrCreateInstance(collapse, { toggle: false })
        .show();
    };

    const tabPane = target.closest('.tab-pane');

    if (
      tabPane &&
      !tabPane.classList.contains('active') &&
      window.bootstrap &&
      bootstrap.Tab
    ) {
      const tabButton = document.querySelector(
        `[data-bs-target="#${tabPane.id}"]`
      );

      if (tabButton) {
        tabButton.addEventListener(
          'shown.bs.tab',
          openContainingAccordion,
          { once: true }
        );

        bootstrap.Tab
          .getOrCreateInstance(tabButton)
          .show();

        return;
      }
    }

    openContainingAccordion();
  }

  container.addEventListener('click', function (event) {
    const jumpLink = event.target.closest('.pharmacy-jump-link');
    if (!jumpLink) return;

    const hash = jumpLink.getAttribute('href');
    if (!hash || hash.charAt(0) !== '#') return;

    event.preventDefault();

    if (window.location.hash !== hash) {
      history.pushState(null, '', hash);
    }

    openAccordionForHash(hash);
  });

  openAccordionForHash();

  window.addEventListener('popstate', function () {
    openAccordionForHash();
  });



  container.addEventListener('focusout', function (event) {
    if (event.target && event.target.dataset && event.target.dataset.pharmacyTemporaryTabindex === 'true') {
      event.target.removeAttribute('tabindex');
      delete event.target.dataset.pharmacyTemporaryTabindex;
    }
  });

});
