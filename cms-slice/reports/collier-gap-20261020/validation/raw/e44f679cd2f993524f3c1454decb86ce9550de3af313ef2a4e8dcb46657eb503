<script>
	(function($) {
		$(document).ready(function() {
			// Check for hash in URL and open the modal if it matches #openirc
			if (location.hash && location.hash === "#openirc") {
				var ircModal = new bootstrap.Modal(document.getElementById('ircModal'));
				ircModal.show();
			}
			
			let captchaAttempts = 0;

			function clear(data) {
				document.getElementById("firstcontact").reset();
				$('#error-message').hide(); // Hide error message when the form is reset
			};

			$('#apptr').click(function() {
				$('#firstcontact').trigger('reset');
				$('#source').val('72f20abebfc1ab4f1b70c7f5595044e444c6eb6ab65b3e1351b54e0e8894c8c1');
				$('#error-message').hide(); // Hide error message when the form is reopened
			});

			function phFormat() {
				$('.phone').on('input', function() {
					var number = $(this).val().replace(/[^\d]/g, '');
					if (number.length >= 10) {
						number = number.replace(/(\d{3})(\d{3})(\d{4})/, "($1) $2-$3");
					}
					$(this).val(number);
				});
			};
			$(phFormat);

			$("#firstcontact").submit(function(event) {
				event.preventDefault();

				var captchaResponse = grecaptcha.getResponse();
				if (captchaResponse.length === 0) {
					captchaAttempts++;
					if (captchaAttempts >= 3) {
						$('#error-message').text("ERROR: The Captcha security check was not completed. If you are unable to complete this form, please phone us at 888-286-2362.").show();
					} else {
						$('#error-message').text("ERROR: Invalid CAPTCHA. Please try again.").show();
					}
					return false;
				} else {
					captchaAttempts = 0; // Reset attempts count on successful CAPTCHA
				}

				submitForm();
			});

			function submitForm() {
				$('.loading-modal').show();
				$('#responseMsg').html('<div class="alert alert-success mt-2 p-2" role="alert">Submitting, please wait...</div>'); // Show message
				$.ajax({
					type: "POST",
					url: "ircmodal_2020.php",
					cache: false,
					data: $('form#firstcontact').serialize(),
					success: function(response) {
						$("#ircrs").html(checkRes(response));
						$("#ircModal").modal('hide');
						$("#resModal").modal('show');
						grecaptcha.reset();
						$('#error-message').hide(); // Hide the error message after a successful submission
						$('#responseMsg').text(''); // Clear message on success
					},
					error: function() {
						alert("Form has already been submitted.");
						grecaptcha.reset();
						$('#responseMsg').text(''); // Clear message on error
					},
					complete: function() {
						$('.loading-modal').hide(); // Hide loading indicator
					}
				});
			}

			function checkRes(str) {
				return String(str)
					.replace(/&/g, "&amp;")
					.replace(/</g, "&lt;")
					.replace(/>/g, "&gt;")
					.replace(/"/g, "&quot;")
					.replace(/'/g, "&#039;")
					.replace(/\//g, "&#x2F;");
			}
		});
    }(jQuery || window.jQuery));
</script>

