        (function () {
            var memberLoginLink = document.getElementById("member-login-link");
            var confirmationModal = document.getElementById("confirmation-modal");
            var closeBtn = document.getElementById("close-btn");
            var cancelBtn = document.getElementById("cancel-btn");
            var continueBtn = document.getElementById("continue-btn");
            var memberLoginUrl = "";

            if (!memberLoginLink || !confirmationModal || !closeBtn || !cancelBtn || !continueBtn) {
                return;
            }

            function closeModal() {
                confirmationModal.style.display = "none";
            }

            memberLoginLink.addEventListener("click", function (event) {
                event.preventDefault();
                memberLoginUrl = memberLoginLink.getAttribute("href") || "";
                confirmationModal.style.display = "block";
            });

            closeBtn.addEventListener("click", closeModal);
            cancelBtn.addEventListener("click", closeModal);

            continueBtn.addEventListener("click", function () {
                if (memberLoginUrl) {
                    window.open(memberLoginUrl, "_blank", "noopener,noreferrer");
                }
                closeModal();
            });

            window.addEventListener("click", function (event) {
                if (event.target === confirmationModal) {
                    closeModal();
                }
            });
        })();
    </script>


    



