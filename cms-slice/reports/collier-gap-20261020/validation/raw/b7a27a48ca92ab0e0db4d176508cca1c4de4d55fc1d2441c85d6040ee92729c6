jQuery(document).ready(function($) {
  let lastScrollTop = 0;
  let lastToggleScroll = 0;
  let scrollDirection = 'down';
  const header = $('.header-container');
  const threshold = $(window).height() * 0.25; // 25% of the window height
  const toggleThreshold = 75;
  
  // Detect scroll events
  $(window).on('scroll', function() {
    // Get current Scroll position
    let currentScroll = $(this).scrollTop();
    
    // Always show header when at the top of the page
    if (currentScroll <= 10) {
      header.removeClass('hidden');
      lastScrollTop = currentScroll;
      return;
    }
    
    // Determine scroll direction more explicitly
    scrollDirection = currentScroll > lastScrollTop ? 'down' : 'up';
    
    // Only start hiding after threshold has been passed
    if (currentScroll > threshold) {
      // Check if we need to debounce the scroll action
      if (Math.abs(currentScroll - lastToggleScroll) > toggleThreshold) {
        if (scrollDirection === 'down') {
          header.addClass('hidden');
        } else {
          header.removeClass('hidden');
        }
        
        // Update lastToggleScroll position
        lastToggleScroll = currentScroll;
      }
    } else {
      // Always show header before threshold
      header.removeClass('hidden');
    }
    
    // Update the last scroll position
    lastScrollTop = currentScroll;
  });
  
  // Handle visibility when page becomes visible again
  $(document).on('visibilitychange', function() {
    if (!document.hidden) {
      // Short timeout to let any pending scroll events settle
      setTimeout(function() {
        // If user is scrolling up or at the top, show the header
        let currentScroll = $(window).scrollTop();
        if (currentScroll < lastScrollTop || currentScroll <= 10) {
          header.removeClass('hidden');
        }
        lastScrollTop = currentScroll;
      }, 100);
    }
  });
  
  // Reset on resize
  $(window).on('resize', function() {
    if ($(window).width() > 1024) {
      header.removeClass('hidden');
    }
