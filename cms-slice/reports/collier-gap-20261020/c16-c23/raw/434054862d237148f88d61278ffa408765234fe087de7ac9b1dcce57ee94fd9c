                   data-bind="value: Id, checked: isRequested, enable: enableRequested, visible: !isTradeSecret"
                   title="Check to select this document" />
        </td>
        <td data-bind="css: { tradesecret: isTradeSecret }">
            <span class="oir-label k-label" data-bind="text: documentTitle"></span>
            <br />
            <em><span class="oir-label k-label" data-bind="text: documentType"></span></em>
        </td>
        <td><span class="k-label" data-bind="text: formNumber"></span>&nbsp;</td>
        <td><span class="k-label" data-bind="text: documentDate"></span>&nbsp;</td>
        <td><span class="k-label" data-bind="text: documentStatus"></span>&nbsp;</td>
        <td><span class="k-label" data-bind="text: filler"></span>&nbsp;</td>
    </tr>
</script>

<div class="modal fade" id="modalComment" tabindex="-1" role="dialog" aria-labelledby="modalCommentLabel">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form>
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                    <h5 class="modal-title" id="modalCommentLabel">Consumer Comments</h5>
                </div>
                <div class="modal-body" data-bind="with: commentRequest">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <label>File Log Number:</label>
                            </div>
                            <div class="col-sm-12">
                                <span id="commentFileLogNum" data-bind="text: fileLogNumber"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-12">
                                <label>Company Name:</label>
                            </div>
                            <div class="col-sm-12">
                                <span id="commentCompanyName" data-bind="text: companyName"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-12">
                                <label for="commentEmail"><span class="required-indicator">*</span>Email Address:</label>
                            </div>
                            <div class="col-sm-12">
                                <input type="email" id="commentEmail" class="form-control input-sm oir-input-full" placeholder="e.g. myname@example.net"
                                       data-bind="value: emailAddress" title="Enter a valid email address"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-12">
                                <label for="commentComments"><span class="required-indicator">*</span>Comments:</label>
                            </div>
                            <div class="col-sm-12">
                                <textarea id="commentComments" rows="5" class="form-control input-sm oir-input-full" placeholder="Enter comments"
                                          data-bind="value: comments"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-12">
                                <label>Acknowledgement</label>
                            </div>
                            <div class="col-sm-12 m-b-xs">
                                <div>I acknowledge that I have not included any personal or private health information, such as my policy number, my or my family member’s medical condition, physician name, or any other information of a personal nature. I further acknowledge that my response will become part of this filing's record, and as such, may be reviewed by OIR staff and the public.</div>
                            </div>
                            <div class="col-sm-12 form-inline">
                                <img class="oir-captcha-img verticalAlignMiddle"
                                     src="#" width="130" height="30" id="commentCap" alt="Challenge response image"/>&nbsp;
                                <button type="button" class="btn btn-sm btn-default" data-bind="click: $root.getCapImgUrl.bind($data, 'commentCap')" title="Get new image"><i class="fa fa-fw fa-lg fa-refresh"></i></button>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-12">
                                <label for="commentImage"><span class="required-indicator">*</span>Enter answer from the image above:</label>
                            </div>
                            <div class="col-sm-12">
                                <input id="commentImage" name="commentImage" maxlength="6" type="text" class="form-control input-sm oir-captcha" placeholder="Enter answer" data-bind="value: captcha"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-sm btn-primary oir-button-toolbar pull-right" data-bind="click: submitComment">Submit</button>
                    <a href="#" class="btn btn-sm btn-default oir-button-toolbar pull-right" data-dismiss="modal">Close</a>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="modalDocuments" tabindex="-1" role="dialog" aria-labelledby="modalDocumentsLabel">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form>
                
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                    <h5 class="modal-title" id="modalDocumentsLabel">
                        Filing Document Request
                        <small class="pull-right m-r-xs m-t-xs"><span id="modalDocumentsOpenTimer">00:00</span></small>
                    </h5>
                </div>
                <div class="modal-body" data-bind="with: pdfRequest">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div>Below is a list of all documents available in the selected form or rate filing. There are three options for requesting documents within a filing: 1) as a single PDF containing all documents in the filing; 2) as a single request only containing stamped documents; or 3) through a manual selection of only the individual documents you wish to receive. In the “Request Type” field below, select the preferred method. If you are requesting individual documents by manual selection, check the applicable box next to each document. Next, enter a valid email address and then answer the math question provided in the image box. Click “Submit” to finalize the request. Your request will be processed and the documents sent to the email address provided.<br/><strong>NOTE: Documents marked as trade secret cannot be requested.</strong></div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-12 form-inline">
                                <label>File Log Number:</label>
                                <span id="requestFileLogNum" data-bind="text: fileLogNumber"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-12">
                                <label for="selectedPdfRequestOption"><span class="required-indicator">*</span>Request Type:</label>
                            </div>
                            <div class="col-sm-6">
                                <input id="selectedPdfRequestOption" class="form-control input-sm oir-input-full"
                                       data-bind="kendoDropDownList: { dataTextField: 'name', dataValueField: 'id', data: pdfRequestOptions, value: selectedPdfRequestOption, optionLabel: 'Select an action...'}"/>
                            </div>
                            <div class="col-sm-6">
                                <button type="submit" class="btn btn-sm btn-primary oir-button-toolbar" data-bind="visible: selectedPdfRequestOption() > 0, click: $root.submitRequest">Submit</button>
                                <a href="#" class="btn btn-sm btn-default oir-button-toolbar" data-dismiss="modal">Close</a>
                            </div>
                        </div>
                        <div class="form-group" data-bind="visible: selectedPdfRequestOption() > 0">
                            <div class="col-sm-12">
                                <label for="requestEmail"><span class="required-indicator">*</span>Email Address:</label>
                            </div>
                            <div class="col-sm-6">
                                <input type="email" id="requestEmail" class="form-control input-sm oir-input-full" placeholder="e.g. myname@example.net"
                                       data-bind="value: requestEmailAddress" title="Enter a valid email address"/>
                            </div>
                        </div>
                        <div class="form-group" data-bind="visible: selectedPdfRequestOption() > 0">
                            <div class="col-sm-12 form-inline">
                                <img class="oir-captcha-img .verticalAlignMiddle" src="#" width="125" height="30" id="documentCap" alt="Challenge response image"/>&nbsp;
                                <button type="button" class="btn btn-sm btn-default" data-bind="click: $root.getCapImgUrl.bind($data, 'documentCap')" title="Get new image"><i class="fa fa-fw fa-lg fa-refresh"></i></button>
                            </div>
                        </div>
                        <div class="form-group" data-bind="visible: selectedPdfRequestOption() > 0">
                            <div class="col-sm-12">
                                <label for="requestImage">*Enter answer from the image above.</label>
                            </div>
                            <div class="col-sm-12">
                                <input id="requestImage" name="requestImage" maxlength="6" type="text" class="form-control input-sm oir-captcha" placeholder="Enter answer" data-bind="value: captcha"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-12">
                                <span class="m-l-sm" data-bind="visible: selectedPdfRequestOption()==5">
                                    <input type="checkbox" data-bind="checked: checkAllDocuments"/>
                                    <label>Select all</label>
                                </span>
                                <div id="documentsGrid" data-bind="kendoGrid: $root.gridRequestOptions"></div>
                                <div class="m-t-sm m-b-sm">Document Count:&nbsp;<span id="myDocCount" data-bind="text: !!filingDocuments() ? filingDocuments().length : 'n/a'"></span></div>
                                <div><label><i>* - Fields marked with an asterisk (*) have been asserted "Trade Secret" by the company.</i></label></div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

