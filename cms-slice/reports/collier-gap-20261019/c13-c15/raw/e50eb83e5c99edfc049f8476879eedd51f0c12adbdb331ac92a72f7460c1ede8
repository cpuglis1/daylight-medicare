  box-shadow: 0 2px 16px rgba(125,63,152,0.07);
  border: 1.5px solid transparent;
  height: 100%; display: flex; flex-direction: column; gap: 12px;
  transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
