                        placeholder="Select Option"
                        [ngClass]="{ 'hide-dropdown-icon': !disableAppCreation }"
                        required
                      ></p-select>
                        </div>

                      <div class="myapp-form-group">
                        <label for="appenv" class="myapp-form-label">Application Environment</label>
                        <p-select
                        [disabled]="!disableAppCreation"
                        id="appenv"
                        name="appenv"
                        [options]="path"
                        [(ngModel)]="pathValue"
                        placeholder="Select Option"
                        [ngClass]="{ 'hide-dropdown-icon': !disableAppCreation }"
                        required
