.lp-feat-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 40px rgba(125,63,152,0.15);
  border-color: #d8b4fe;
}
.lp-feat-icon {
  width: 54px; height: 54px; border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; flex-shrink: 0;
}
.lp-feat-icon-blue   { background: linear-gradient(135deg, #dbeafe, #bfdbfe); color: #1d4ed8; }
.lp-feat-icon-purple { background: linear-gradient(135deg, #f3e8ff, #e9d5ff); color: #7c3aed; }
.lp-feat-icon-teal   { background: linear-gradient(135deg, #ccfbf1, #99f6e4); color: #0d9488; }
.lp-feat-icon-orange { background: linear-gradient(135deg, #ffedd5, #fed7aa); color: #ea580c; }
.lp-feat-title { font-size: 1.1rem; font-weight: 700; color: #1a1a2e; margin: 0; }
.lp-feat-body {
  font-size: 0.9rem;
  color: #555;
  line-height: 1.6;
  flex: 1;
  overflow: visible;        /* \u2190 allow full text */
  display: block;           /* \u2190 remove -webkit-box */
  -webkit-line-clamp: unset;/* \u2190 remove clamp */
  line-clamp: unset;
  -webkit-box-orient: unset;
}.lp-feat-link {
  display: inline-flex; align-items: center; gap: 6px;
  color: #7d3f98; font-weight: 700; font-size: 0.88rem;
  text-decoration: none; margin-top: auto;
  transition: gap 0.2s;
}
.lp-feat-link:hover { gap: 10px; color: #5c2d7a; }
.lp-feat-link i { font-size: 12px; }

/* \u2500\u2500 CTA STRIP \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */
.lp-cta { background: #f4f6fb; padding: 60px 0 72px; }
.lp-cta-inner {
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, #2d0f5c 0%, #7d3f98 50%, #0070c0 100%);
  border-radius: 24px; padding: 52px 48px;
  display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap;
  box-shadow: 0 16px 60px rgba(125,63,152,0.35);
}
.lp-cta-orb {
  position: absolute; width: 350px; height: 350px; border-radius: 50%;
  background: rgba(255,255,255,0.06); top: -100px; right: -60px;
  pointer-events: none;
}
.lp-cta-copy { position: relative; z-index: 1; }
.lp-cta-title { font-size: 1.75rem; font-weight: 800; color: #fff; margin-bottom: 8px; }
.lp-cta-sub { color: rgba(255,255,255,0.75); font-size: 1rem; margin: 0; }
.lp-cta-actions { display: flex; gap: 14px; flex-wrap: wrap; position: relative; z-index: 1; }
.lp-btn-cta-primary {
  display: inline-flex; align-items: center;
  background: #fff; color: #5c2d7a;
  padding: 13px 28px; border-radius: 30px;
  font-weight: 700; font-size: 0.95rem; text-decoration: none;
  box-shadow: 0 4px 16px rgba(0,0,0,0.15);
  transition: transform 0.2s, box-shadow 0.2s;
}
.lp-btn-cta-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.2); color:#5c2d7a; }
.lp-btn-cta-ghost {
  display: inline-flex; align-items: center;
  background: transparent; border: 2px solid rgba(255,255,255,0.4);
  color: #fff; padding: 11px 26px; border-radius: 30px;
  font-weight: 600; font-size: 0.95rem; text-decoration: none;
  transition: background 0.2s, border-color 0.2s;
}
.lp-btn-cta-ghost:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.7); color:#fff; }

@media (max-width: 768px) {
  .lp-stats-grid { flex-direction: column; gap: 4px; }
  .lp-stat-divider { width: 60px; height: 1px; }
  .lp-cta-inner { flex-direction: column; text-align: center; padding: 36px 24px; }
  .lp-cta-actions { justify-content: center; }
  .lp-hero { padding: 90px 0 50px; }
}
