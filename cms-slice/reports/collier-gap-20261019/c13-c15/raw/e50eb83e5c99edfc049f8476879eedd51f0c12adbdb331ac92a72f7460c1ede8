                    @if (payerName.errors?.required) { <small class="pq-error">* Please enter Organization Name </small> }
                  }
                  <input pInputText id="payerName" class="pq-input w-full" name="payerName" #payerName="ngModel"
                    [(ngModel)]="userValues.payerName" (blur)="userValues.payerName = userValues.payerName?.trim()"
                    minlength="1" maxlength="80" required />
                </div>

                <!-- Registrant First/Last Name -->
                <div class="pq-form-group">
                  <label class="pq-label">Registrant First Name <span class="pq-required">*</span></label>
                  @if (registrantName.touched) {
                    @if (registrantName.errors?.required) { <small class="pq-error">* Please enter Registrant's First Name</small> }
                  }
                  <input pInputText id="registrantName" class="pq-input w-full" name="registrantName" #registrantName="ngModel"
                    [(ngModel)]="firstName" (blur)="firstName = firstName?.trim()"
                    minlength="1" maxlength="80" required />
                </div>

                <div class="pq-form-group">
                  <label class="pq-label">Registrant Last Name <span class="pq-required">*</span></label>
                  @if (registrantLastName.touched) {
                    @if (registrantLastName.errors?.required) { <small class="pq-error">* Please enter Registrant's Last Name</small> }
                  }
                  <input pInputText id="registrantLastName" class="pq-input w-full" name="registrantLastName" #registrantLastName="ngModel"
                    [(ngModel)]="lastName" (blur)="lastName = lastName?.trim()"
                    minlength="1" maxlength="80" required />
                </div>

                <!-- Registrant Role -->
                <div class="pq-form-group pq-form-full">
                  <label class="pq-label">Registrant's role within the company <span class="pq-required">*</span></label>
                  @if (registrantRole.touched && registrantRole.errors?.required) { <small class="pq-error">* Please enter Registrant's role within the company</small> }
                  <input pInputText id="registrantRole" class="pq-input w-full" name="registrantRole" #registrantRole="ngModel"
                    [(ngModel)]="userValues.registrantRole" (blur)="userValues.registrantRole = userValues.registrantRole?.trim()"
                    minlength="1" maxlength="80" required />
                </div>

                <!-- Authorized Delegate -->
                <div class="pq-form-group pq-form-full">
                  <label class="pq-label">Are you an authorized delegate for your Health system? <span class="pq-required">*</span></label>
                  @if (authorizeddelegate.touched && !authorizeddelegateOpen && authorizeddelegate.errors?.required) { <small class="pq-error">* Please select an option</small> }
                  <p-select [options]="yesNoOptions" optionLabel="label" optionValue="value"
                    placeholder="Please select an option" name="authorizeddelegate" inputId="authorizeddelegate"
                    #authorizeddelegate="ngModel" [(ngModel)]="userValues.authorizeddelegate" class="w-full" styleClass="w-full" panelStyleClass="pq-dropdown-panel" appendTo="body"
                    (onShow)="authorizeddelegateOpen = true" (onHide)="authorizeddelegateOpen = false" required />
                </div>

                <!-- ONC Fieldset -->
                <div class="pq-form-full">
                  <div class="pq-fieldset">
                    <div class="pq-fieldset-legend"><i class="pi pi-building"></i> ONC Health IT Developer Information</div>
                    <div class="pq-fieldset-body">
                      <div class="pq-form-grid">

                        <div class="pq-form-group">
                          <label class="pq-label">Developer Contact First and Last Name</label>
                          <input pInputText id="devName" class="pq-input w-full" name="devName" #devName="ngModel"
                            [(ngModel)]="userValues.devName" (blur)="userValues.devName = userValues.devName?.trim()"
                            minlength="1" maxlength="80" />
                        </div>

                        <div class="pq-form-group">
                          <label class="pq-label">Developer Contact Email Address</label>
                          <input pInputText id="devEmail" class="pq-input w-full" name="devEmail" #devEmail="ngModel"
                            [(ngModel)]="userValues.devEmail" (blur)="userValues.devEmail = userValues.devEmail?.trim()"
                            pattern="^\\S+@\\S+$" minlength="1" maxlength="80" />
                        </div>

                        <div class="pq-form-group">
                          <label class="pq-label">Country Code</label>
                          <p-select [options]="countries" optionLabel="name" optionValue="code3"
                            placeholder="Select Country" name="devCountryCode" inputId="devCountryCode"
                            #devCountryCode="ngModel" [(ngModel)]="userValues.devCountryCode"
                            class="w-full" filterBy="name" [filter]="true">
                            <ng-template pTemplate="selectedItem" let-item>@if (item) { {{item.name}} - {{item.number}} }</ng-template>
                            <ng-template pTemplate="item" let-item>
                              <div class="flex align-items-center justify-content-between w-full">
                                <span>{{item.name}}</span><span class="text-500 ml-2">{{item.number}}</span>
                              </div>
                            </ng-template>
                          </p-select>
                        </div>

  

                        <div class="pq-form-group">
                          <label class="pq-label">Developer Contact Telephone Number</label>
                          <input pInputText id="devContactTelephone" class="pq-input w-full" name="devContactTelephone" #devContactTelephone="ngModel"
                            [(ngModel)]="userValues.devContactTelephone"
                            (blur)="onDevTelephoneBlur()"
                            placeholder="e.g. (800) 555-1234"
                            />
                        </div>

                        <!-- Developer Contact Street Address -->
                        <div class="pq-form-group">
                          <label class="pq-label">Developer Contact Street Address</label>
                          <input pInputText id="oncStreet" class="pq-input w-full" name="oncStreet" #oncStreet="ngModel"
                            [(ngModel)]="userValues.oncStreet" (blur)="userValues.oncStreet = userValues.oncStreet?.trim()"
                            minlength="1" maxlength="180" />
                        </div>

                        <div class="pq-form-group">
                          <label class="pq-label">City</label>
                          <input pInputText id="devCity" class="pq-input w-full" name="devCity" #devCity="ngModel"
                            [(ngModel)]="userValues.devCity" (blur)="userValues.devCity = userValues.devCity?.trim()" minlength="1" maxlength="180" />
                        </div>

                        <div class="pq-form-group">
                          <label class="pq-label">State</label>
                          <input pInputText id="devState" class="pq-input w-full" name="devState" #devState="ngModel"
                            [(ngModel)]="userValues.devState" (blur)="userValues.devState = userValues.devState?.trim()" minlength="1" maxlength="180" />
                        </div>

                        <div class="pq-form-group">
                          <label class="pq-label">Zip Code</label>
                          <input pInputText id="devZip" class="pq-input w-full" name="devZip" #devZip="ngModel"
                            [(ngModel)]="userValues.devZip" (blur)="userValues.devZip = userValues.devZip?.trim()" minlength="1" maxlength="10" />
                        </div>

                        <div class="pq-form-group">
                          <label class="pq-label">Country</label>
                          <p-select [options]="devCountries" optionLabel="name" optionValue="name"
                            placeholder="Select Country" name="devcountry" inputId="devcountry"
                            #devcountry="ngModel" [(ngModel)]="userValues.devcountry" class="w-full" [filter]="true" />
                        </div>

                      </div>
                    </div>
                  </div>
                </div>

                <!-- Add Contacts Fieldset -->
                <div class="pq-form-full">
                  <div class="pq-fieldset">
                    <div class="pq-fieldset-legend"><i class="pi pi-users"></i> Add Contacts</div>
                    <div class="pq-fieldset-body">
                      <form #multipleContact="ngForm">
                        <div class="pq-form-grid">

                          <div class="pq-form-group pq-form-full">
                            <label class="pq-label">Contact First and Last Name <span class="pq-required">*</span></label>
                            @if (contactName.touched) {
                              @if (contactName.errors?.required) { <small class="pq-error">* Please enter Contact First and Last Name</small> }
                            }
                            <input pInputText id="contactName" class="pq-input w-full" name="contactName" #contactName="ngModel"
                              [(ngModel)]="userValues.contactName" (blur)="userValues.contactName = userValues.contactName?.trim()"
                              minlength="1" maxlength="80" required />
                          </div>

                          <div class="pq-form-group pq-form-full">
                            <label class="pq-label">Contact Business Email <span class="pq-required">*</span></label>
                            @if (email.touched) {
                              @if (email.errors?.required) { <small class="pq-error">* Please enter Contact Business Email</small> }
                              @if (email.errors?.pattern) { <small class="pq-error">* Please enter valid email</small> }
                            }
                            <input pInputText id="email" class="pq-input w-full" name="email" #email="ngModel"
                              [(ngModel)]="userValues.email" (blur)="userValues.email = userValues.email?.trim()"
                              pattern="^\\S+@\\S+$" minlength="1" maxlength="80" required />
                          </div>

                          <div class="pq-form-group">
                            <label class="pq-label">Country Code <span class="pq-required">*</span></label>
                            @if (countryCode.touched && countryCode.errors?.required) { <small class="pq-error">* Please select your Country code</small> }
                            <p-select [options]="countries" optionLabel="name" optionValue="code3"
                              placeholder="Select Country" name="countryCode" inputId="countryCode"
                              #countryCode="ngModel" [(ngModel)]="userValues.countryCode"
                              class="w-full" filterBy="name" [filter]="true" required>
                              <ng-template pTemplate="selectedItem" let-item>@if (item) { {{item.name}} - {{item.number}} }</ng-template>
                              <ng-template pTemplate="item" let-item>
                                <div class="flex align-items-center justify-content-between w-full">
                                  <span>{{item.name}}</span><span class="text-500 ml-2">{{item.number}}</span>
                                </div>
                              </ng-template>
                            </p-select>
                          </div>

                          <div class="pq-form-group">
                            <label class="pq-label">Telephone Number <span class="pq-required">*</span></label>
                            @if (telephone.touched) {
                              @if (telephone.errors?.required) { <small class="pq-error">* Please enter Telephone Number</small> }
                            }
                            <input pInputText id="telephone" class="pq-input w-full" name="telephone" #telephone="ngModel"
                              [(ngModel)]="userValues.telephone"
                              (blur)="onTelephoneBlur()"
                              placeholder="e.g. (800) 555-1234"
                              required />
                          </div>

                          <div class="pq-form-full">
                            <button pButton type="button" label="Add Contact" icon="pi pi-plus"
                              (click)="addMultipleRequest()" [disabled]="multipleContact?.invalid" class="pq-add-btn">
                            </button>
                          </div>

                          @if (DisplayMultipleRequest) {
                            <div class="pq-form-full">
                              <div class="pq-contacts-table-wrap">
                                <table class="pq-contacts-table">
                                  <thead>
                                    <tr>
                                      <th><i class="pi pi-user"></i> Contact Name</th>
                                      <th><i class="pi pi-envelope"></i> Business Email</th>
                                      <th><i class="pi pi-globe"></i> Country Code</th>
                                      <th><i class="pi pi-phone"></i> Telephone</th>
                                      <th><i class="pi pi-trash"></i> Remove</th>
                                      <th><i class="pi pi-pencil"></i> Edit</th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    @for (rowData of MultipleRequest; track rowData) {
                                      <tr class="pq-contacts-row">
                                        <td class="text-break">{{rowData['contactName']}}</td>
                                        <td class="text-break">{{rowData['contactBusinessEmailText']}}</td>
                                        <td class="text-break">{{rowData['countryCode']}}</td>
                                        <td class="text-break">{{rowData['contactTelephoneNumber']}}</td>
                                        <td><button class="pq-icon-btn pq-btn-danger" type="button" (click)="deleteRow(rowData)"><i class="pi pi-trash"></i></button></td>
                                        <td><button class="pq-icon-btn pq-btn-edit" type="button" (click)="editContact(rowData)"><i class="pi pi-pencil"></i></button></td>
                                      </tr>
                                    }
                                  </tbody>
                                </table>
                              </div>
                            </div>
                          }

                        </div>
                      </form>
                    </div>
                  </div>
                </div>

                <!-- Organization Country -->
                <div class="pq-form-group pq-form-full">
                  <label class="pq-label">In what country is your organization domiciled? <span class="pq-required">*</span></label>
                  @if (country.touched && country.errors?.required) { <small class="pq-error">* Please select a country</small> }
                  <p-select [options]="countries" optionLabel="name" optionValue="name"
                    placeholder="Select Country" name="country" inputId="country"
                    #country="ngModel" [(ngModel)]="userValues.country" class="w-full" [filter]="true" required />
                </div>

                <!-- PHI Storage Country -->
                <div class="pq-form-group pq-form-full">
                  <label class="pq-label">In what country would member PHI data be stored? <span class="pq-required">*</span></label>
                  @if (storagecountry.touched && storagecountry.errors?.required) { <small class="pq-error">* Please select a country</small> }
                  <p-select [options]="countries" optionLabel="name" optionValue="name"
                    placeholder="Select Country" name="storagecountry" inputId="storagecountry"
                    #storagecountry="ngModel" [(ngModel)]="userValues.storagecountry" class="w-full" [filter]="true" required />
                </div>
                
                <!-- Contract ID -->
                <div class="pq-form-group pq-form-full">
                  <label class="pq-label">Contract ID <span class="pq-required">*</span></label>
                  <small class="pq-hint">If you don't have a Contract ID, enter NA.</small>
                  @if (contractId.touched && contractId.errors?.required) {
                    <small class="pq-error">* Please enter Contract ID</small>
                  }
                  <input pInputText id="contractId" class="pq-input w-full" name="contractId" #contractId="ngModel"
                    [(ngModel)]="userValues.contractId" (blur)="userValues.contractId = userValues.contractId?.trim()"
                    minlength="1" maxlength="100" required />
                </div>

                <!-- Domain List -->
                <div class="pq-form-group pq-form-full">
                  <label class="pq-label">Please list all domain names that you plan to use to connect with our infrastructure <span class="pq-required">*</span></label>
                  @if (domainlist.touched && domainlist.errors?.required) { <small class="pq-error">* Please enter domain names</small> }
                  <textarea pInputTextarea id="domainlist" class="pq-input w-full" rows="4" name="domainlist" #domainlist="ngModel"
                    [(ngModel)]="userValues.domainlist" (blur)="userValues.domainlist = userValues.domainlist?.trim()"
                    minlength="1" maxlength="1000" required>
                  </textarea>
                </div>
                <!-- API Usage -->
                <div class="pq-form-group pq-form-full">
                  <label class="pq-label">
                    Please identify the Interoperability API(s) you intend to use and describe how the data will be used within your solution.
                    <span class="pq-required">*</span>
                  </label>
                  @if (apiUsage.touched && apiUsage.errors?.required) {
                    <small class="pq-error">* Required: Identify API(s) and describe your intended data use</small>
                  }
                  @if (apiUsage.touched && apiUsage.errors?.maxlength) {
                    <small class="pq-error">* Maximum 2048 characters allowed</small>
                  }
                  <textarea
                    pInputTextarea
                    id="apiUsage"
                    class="pq-input w-full"
                    rows="4"
                    name="apiUsage"
                    #apiUsage="ngModel"
                    [(ngModel)]="userValues.apiUsage"
                    (blur)="userValues.apiUsage = userValues.apiUsage?.trim()"
                    minlength="1"
                    maxlength="2048"
                    required
                  ></textarea>
                </div>

                <!-- Type of System -->
                <div class="pq-form-group pq-form-full">
                  <label class="pq-label">
                    How would you best describe the type of system your application represents?
                    <span class="pq-required">*</span>
                  </label>
                  @if (systemType?.touched && systemType?.errors?.required) {
                    <small class="pq-error">* Required: select an option</small>
                  }
                  <p-select
                    [options]="systemTypeOptions"
                    optionLabel="label"
                    optionValue="value"
                    placeholder="Please select an option"
                    name="systemType"
                    inputId="systemType"
                    #systemType="ngModel"
                    [(ngModel)]="userValues.systemType"
                    class="w-full"
                    appendTo="body"
                    required
                  ></p-select>
                </div>

                  

                <!-- Security Practices -->
                <div class="pq-form-group pq-form-full">
                  <label class="pq-label">Do you agree to follow common security practices such as OWASP Top 10 and SANS Top 25? <span class="pq-required">*</span></label>
                  @if (securitypractices.touched && !securitypracticesOpen && securitypractices.errors?.required) { <small class="pq-error">* Please select an option</small> }
                  <p-select [options]="yesNoOptions" optionLabel="label" optionValue="value"
                    placeholder="Please select an option" name="securitypractices" inputId="securitypractices"
                    #securitypractices="ngModel" [(ngModel)]="userValues.securitypractices" class="w-full" styleClass="w-full" panelStyleClass="pq-dropdown-panel" appendTo="body"
                    (onShow)="securitypracticesOpen = true" (onHide)="securitypracticesOpen = false" required />
                </div>

                <!-- Review -->
                <div class="pq-form-group pq-form-full">
                  <label class="pq-label">Are your application standards regularly reviewed (at least annually) to account for changes in environment, available security features and/or leading practices? <span class="pq-required">*</span></label>
                  @if (review.touched && !reviewOpen && review.errors?.required) { <small class="pq-error">* Please select an option</small> }
                  <p-select [options]="yesNoOptions" optionLabel="label" optionValue="value"
                    placeholder="Please select an option" name="review" inputId="review"
                    #review="ngModel" [(ngModel)]="userValues.review" class="w-full" styleClass="w-full" panelStyleClass="pq-dropdown-panel" appendTo="body"
                    (onShow)="reviewOpen = true" (onHide)="reviewOpen = false" required />
                </div>

                <!-- Validation Summary -->
                <div class="pq-form-full">
                  @if (payerQuestionnaireForm.submitted && (payerQuestionnaireForm.invalid || contactArray)) {
                    <div class="pq-validation-summary">
                      <div class="pq-validation-title"><i class="pi pi-exclamation-circle"></i> Please fix the following errors:</div>
                      @if (payerName.invalid && payerName.errors?.required) {
                        <div class="pq-validation-item"><i class="pi pi-times-circle"></i> Required: Organization Name</div>
                      }
                      @if (registrantName.invalid && registrantName.errors?.required) {
                        <div class="pq-validation-item"><i class="pi pi-times-circle"></i> Required: Registrant First Name</div>
                      }
                      @if (registrantLastName.invalid && registrantLastName.errors?.required) {
                        <div class="pq-validation-item"><i class="pi pi-times-circle"></i> Required: Registrant Last Name</div>
                      }
                      @if (registrantRole.invalid && registrantRole.errors?.required) {
                        <div class="pq-validation-item"><i class="pi pi-times-circle"></i> Required: Registrant's role</div>
                      }
                      @if (authorizeddelegate.invalid && authorizeddelegate.errors?.required) {
                        <div class="pq-validation-item"><i class="pi pi-times-circle"></i> Required: Authorized delegate option</div>
                      }
                      @if (contactArray) { <div class="pq-validation-item"><i class="pi pi-times-circle"></i> Please add at least one Contact</div> }

                      @if (country.invalid && country.errors?.required) {
                        <div class="pq-validation-item"><i class="pi pi-times-circle"></i> Required: Organization domiciled country</div>
                      }
                      @if (storagecountry.invalid && storagecountry.errors?.required) {
                        <div class="pq-validation-item"><i class="pi pi-times-circle"></i> Required: Member PHI data storage country</div>
                      }
                      @if (contractId.invalid && contractId.errors?.required) {
                        <div class="pq-validation-item"><i class="pi pi-times-circle"></i> Required: Contract ID</div>
                      }
                      @if (domainlist.invalid && domainlist.errors?.required) {
                        <div class="pq-validation-item"><i class="pi pi-times-circle"></i> Required: Domain names</div>
                      }
                      @if (apiUsage.invalid && apiUsage.errors?.required) {
                        <div class="pq-validation-item"><i class="pi pi-times-circle"></i> Required: Interoperability APIs and data usage intent</div>
                      }
                      @if (systemType.invalid && systemType.errors?.required) {
                        <div class="pq-validation-item"><i class="pi pi-times-circle"></i> Required: Type of system</div>
                      }
                      @if (securitypractices.invalid && securitypractices.errors?.required) {
                        <div class="pq-validation-item"><i class="pi pi-times-circle"></i> Required: Security practices option</div>
                      }
                      @if (review.invalid && review.errors?.required) {
                        <div class="pq-validation-item"><i class="pi pi-times-circle"></i> Required: Application review option</div>
                      }
                    </div>
                  }
                </div>
                 
                 
                

                <!-- Submit -->
                <div class="pq-form-full pq-submit-row">
                  <button pButton type="submit" label="Submit Questionnaire" icon="pi pi-send" class="pq-submit-btn"></button>
                </div>

              </div>
            </form>

          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Please Wait Dialog -->
<p-dialog [modal]="true" [closable]="false" header="Please Wait" [(visible)]="showSpiner"
  [style]="{width: '25rem'}" [contentStyle]="{ background: '#ffffff' }">
  <div class="flex flex-column align-items-center justify-content-center p-4" style="background:#ffffff;">
    <p-progress-spinner styleClass="w-4rem h-4rem" strokeWidth="4" fill="#ffffff" animationDuration=".5s" />
    <span class="mt-3 font-semibold" style="color:#555;">Processing, please wait...</span>
  </div>
</p-dialog>

<style>
  .pq-bg { background: linear-gradient(135deg, #f0f2f5 0%, #e8eaf0 100%); min-height: calc(100vh - 60px); width: 100%; padding-bottom: 40px; }
  .pq-container { padding: 32px 24px; max-width: 1400px; margin: 0 auto; }

  .pq-page-header { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; margin-bottom: 28px; }
  .pq-page-title { font-size: 26px; font-weight: 700; color: #2d2d2d; margin: 0; line-height: 1.2; display: flex; align-items: center; gap: 10px; }
  .pq-title-icon { font-size: 22px; color: #7d3f98; }
  .pq-page-subtitle { font-size: 14px; color: #212529; margin: 0; }

  .pq-card { background: #fff; border-radius: 16px; border: 1px solid #ede0f7; box-shadow: 0 4px 20px rgba(125,63,152,0.08); overflow: visible; }
  .pq-card-header { display: flex; align-items: center; gap: 10px; padding: 18px 24px; background: linear-gradient(135deg, #7d3f98 0%, #5c2d7a 100%); border-radius: 16px 16px 0 0; }
  .pq-card-icon { font-size: 20px; color: #fff; }
  .pq-card-title { font-size: 18px; font-weight: 600; color: #fff; letter-spacing: 0.3px; }
  .pq-card-body { padding: 24px; background: #fff; border-radius: 0 0 16px 16px; }

  .pq-profile-row { display: flex; gap: 16px; }
  .pq-profile-field { display: flex; flex-direction: column; flex: 1; padding: 12px 14px; background: #f8f4fc; border-radius: 10px; border-left: 4px solid #7d3f98; }
  .pq-profile-label { font-size: 11px; font-weight: 700; text-transform: uppercase; color: #7d3f98; letter-spacing: 0.8px; margin-bottom: 4px; }
  .pq-profile-value { font-size: 14px; font-weight: 500; color: #2d2d2d; }

  .pq-remarks-header { background: linear-gradient(135deg, #b71c1c, #8b0000) !important; }
  .pq-remarks-body { display: flex; align-items: flex-start; gap: 10px; padding: 4px 0; }
  .pq-remarks-icon { color: #C8102E; font-size: 18px; flex-shrink: 0; margin-top: 2px; }
  .pq-remarks-text { color: #b71c1c; font-size: 14px; font-weight: 500; line-height: 1.5; }

  .pq-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 24px; }
  .pq-form-group { display: flex; flex-direction: column; gap: 6px; }
  .pq-form-full { grid-column: 1 / -1; }
  .pq-label { font-size: 13px; font-weight: 600; color: #3d1a5a; line-height: 1.4; }
  .pq-required { color: #e53935; }
  .pq-input { border: 1.5px solid #d9b8f0 !important; border-radius: 8px !important; padding: 9px 12px !important; font-size: 14px !important; transition: border-color 0.2s, box-shadow 0.2s !important; }
  .pq-input:focus { border-color: #7d3f98 !important; box-shadow: 0 0 0 3px rgba(125,63,152,0.12) !important; }
  .pq-error { color: #e53935; font-size: 12px; }
