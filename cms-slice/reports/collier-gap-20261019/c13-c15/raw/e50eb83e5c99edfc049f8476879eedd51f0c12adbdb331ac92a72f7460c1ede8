  border: 1px solid rgba(255,255,255,0.15); border-radius: 16px;
  padding: 0; overflow: hidden;
  box-shadow: 0 24px 60px rgba(0,0,0,0.4);
  animation: lp-card-float 6s ease-in-out infinite alternate;
}
@keyframes lp-card-float { from{transform:translateY(0)} to{transform:translateY(-12px)} }
.lp-api-card-top { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: rgba(125,63,152,0.3); border-bottom: 1px solid rgba(255,255,255,0.1); }
.lp-api-dots { display: flex; gap: 5px; }
.lp-api-dots span { width: 10px; height: 10px; border-radius: 50%; }
.lp-api-dots span:nth-child(1) { background: #ff5f57; }
.lp-api-dots span:nth-child(2) { background: #febc2e; }
.lp-api-dots span:nth-child(3) { background: #28c840; }
.lp-api-label { color: rgba(255,255,255,0.7); font-size: 11px; font-weight: 600; letter-spacing: 0.05em; }
.lp-api-body { padding: 16px; font-family: 'Courier New', monospace; font-size: 12.5px; }
.lp-code-line { display: flex; gap: 6px; margin-bottom: 6px; }
.lp-ck { color: #94a3b8; }
.lp-cv { color: #e2e8f0; }
.lp-cs { color: #4ade80; }
.lp-api-footer { display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; border-top: 1px solid rgba(255,255,255,0.08); }
.lp-status-ok { color: #4ade80; font-size: 12px; font-weight: 700; }
.lp-resp-time { color: rgba(255,255,255,0.4); font-size: 11px; }

.lp-float-pill {
  position: absolute; display: flex; align-items: center; gap: 6px;
  background: rgba(255,255,255,0.12); backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.2); border-radius: 20px;
  color: #fff; font-size: 11.5px; font-weight: 600; padding: 6px 12px;
  white-space: nowrap; box-shadow: 0 4px 16px rgba(0,0,0,0.2);
}
.lp-pill-1 { top: -20px; right: -10px; animation: lp-float 5s ease-in-out infinite alternate; }
.lp-pill-2 { bottom: 60px; left: -30px; animation: lp-float 7s ease-in-out infinite alternate-reverse; }
.lp-pill-3 { bottom: -10px; right: 20px; animation: lp-float 6s ease-in-out infinite alternate; }
.lp-float-pill i { font-size: 13px; color: #c4b5fd; }

.lp-hero-wave { position: absolute; bottom: 0; left: 0; right: 0; line-height: 0; }
.lp-hero-wave svg { width: 100%; height: 70px; display: block; }

/* \u2500\u2500 STATS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */
.lp-stats { background: #fff; padding: 28px 0; box-shadow: 0 2px 20px rgba(0,0,0,0.06); }
