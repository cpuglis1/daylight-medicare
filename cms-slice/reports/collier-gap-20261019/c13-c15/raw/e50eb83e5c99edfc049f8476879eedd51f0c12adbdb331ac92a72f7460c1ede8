  background: #f3eefa;
  border: 1px solid #d9c8e8;
  padding: 2px 10px;
  border-radius: 999px;
  margin-bottom: 0.45rem;
}
.page-header-title {
  font-size: 1.45rem;
  font-weight: 800;
  color: #1a1230;
  margin: 0 0 0.35rem;
  line-height: 1.3;
}
.page-header-sub {
  font-size: 0.88rem;
  color: #6b7280;
  margin: 0;
  line-height: 1.6;
