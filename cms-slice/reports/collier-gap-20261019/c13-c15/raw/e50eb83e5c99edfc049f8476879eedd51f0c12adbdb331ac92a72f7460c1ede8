  formatAemHtml(htmlString) {
    if (!htmlString)
      return "";
    let formattedHtml = htmlString.replace(/<p[^>]*>([\s\S]*?)<\/p>/gi, (match2, innerContent) => {
      const plainText = innerContent.replace(/<[^>]+>/g, "").trim();
      if (plainText.startsWith("Note:") || plainText.startsWith("Note :") || plainText.startsWith("Note")) {
        return `<p class="doc-note-box">${innerContent}</p>`;
      }
      return match2;
    });
    formattedHtml = formattedHtml.replace(/<a\s+([^>]+)>/gi, '<a $1 class="aem-dynamic-link">');
    formattedHtml = formattedHtml.replace(new RegExp(`(?<!href=["'])(https?:\\/\\/[^\\s<]+)`, "gi"), '<a href="$1" class="aem-dynamic-link" target="_blank">$1</a>');
    return formattedHtml;
  }
