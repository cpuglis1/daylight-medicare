                            [(ngModel)]="jwksUrl" (blur)="jwksUrl = jwksUrl.trim()" (input)="markDirty()" required class="myapp-form-input" />
                        </div>

                        <div class="myapp-form-group">
                          <label for="kid" class="myapp-form-label">Key ID <span class="required-star">*</span></label>
                          <input pInputText id="kid" name="kid" #kidL="ngModel"
                            [(ngModel)]="kid" (blur)="kid = kid.trim()" (input)="markDirty()" required class="myapp-form-input" />
                        </div>
                      }

                      <!-- App Name & Callback -->
                      @if (!disableAppCreation) {
                        <div class="myapp-form-group myapp-form-full">
                          <label for="appName" class="myapp-form-label">Application Name <span class="required-star">*</span></label>
                          <input pInputText id="appName" name="appName" #appNameL="ngModel"
                            [(ngModel)]="appName" minlength="1" maxlength="86" (blur)="appName = appName.trim()" (input)="markDirty()" required class="myapp-form-input" />
                        </div>

                        <div class="myapp-form-group myapp-form-full">
                          <label for="callBackUrl" class="myapp-form-label">Callback URL <span class="required-star">*</span></label>
                          <input pInputText id="callBackUrl" name="callBackUrl" #callBackUrlL="ngModel"
                            [(ngModel)]="callBackUrl" (blur)="callBackUrl = callBackUrl.trim()" (input)="markDirty()" required class="myapp-form-input" />
                        </div>
                      }

                      <!-- Dropdowns & Submit -->
                      <div class="myapp-form-group">
                        <label for="role" class="myapp-form-label">I Am Representing</label>
                        <p-select
                        [disabled]="!disableAppCreation"
