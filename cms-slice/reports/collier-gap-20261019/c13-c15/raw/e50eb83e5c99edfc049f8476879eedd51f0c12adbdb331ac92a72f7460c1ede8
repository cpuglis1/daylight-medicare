.lp-features { padding: 72px 0 60px; background: #f4f6fb; }
.lp-section-header { text-align: center; margin-bottom: 44px; }
.lp-section-title { font-size: 2rem; font-weight: 800; color: #1a1a2e; margin-bottom: 10px; }
.lp-section-sub { font-size: 1rem; color: #666; }

.lp-feat-card {
