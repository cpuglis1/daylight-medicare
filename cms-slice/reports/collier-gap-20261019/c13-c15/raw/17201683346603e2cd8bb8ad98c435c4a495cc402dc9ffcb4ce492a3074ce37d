document.addEventListener('DOMContentLoaded', function() {
  // Random image selection
  const images = [
    'sites/all/images/image1_senior_couple.jpg',
    'sites/all/images/image2_senior_couple.jpg',
    'sites/all/images/image3_senior_couple.jpg',
    'sites/all/images/image4_senior_couple.jpg',
    'sites/all/images/image5_senior_couple.jpg',
    'sites/all/images/image6_senior_couple.jpg',
    'sites/all/images/image7_senior_couple.jpg'
  ];
  const heroImage = document.getElementById('heroImageHome');

  if (heroImage) {
    const randomImage = images[Math.floor(Math.random() * images.length)];
    heroImage.src = randomImage;
  }

  // Bootstrap Popovers using Vanilla JS
  const multiColumnCounties = document.querySelector('ul.multi-column-counties');
  if (multiColumnCounties) {
    const popoverTriggerList = multiColumnCounties.querySelectorAll('[data-bs-toggle="popover"]');
    popoverTriggerList.forEach(function(popoverTriggerEl) {
      new bootstrap.Popover(popoverTriggerEl, {
        title: popoverTriggerEl.textContent.trim(),
        content: popoverTriggerEl.dataset.bsContent,
        trigger: 'hover',
        customClass: 'custom-popover'
      });
    });

    // Prevent default action for links inside ul.multi-column-counties
    const links = multiColumnCounties.querySelectorAll('a');
    links.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
      });
    });
  }

  // Disclaimer Collapse Logic
  const fullDisclaimer = document.getElementById('fullDisclaimer');
  if (fullDisclaimer) {
    const viewButton = document.getElementById('viewButton');
    const collapseButton = document.getElementById('collapseButton');

    fullDisclaimer.addEventListener('shown.bs.collapse', function() {
      viewButton.classList.add('d-none');
      collapseButton.classList.remove('d-none');
      collapseButton.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    fullDisclaimer.addEventListener('hidden.bs.collapse', function() {
      viewButton.classList.remove('d-none');
      collapseButton.classList.add('d-none');
    });
  }

  // Alert Section Logic
  const alertSection = document.getElementById('alert-section');
  const dismissButton = document.getElementById('dismiss-alert');
  const restoreSpan = document.getElementById('restore-alert');

  if (alertSection && dismissButton && restoreSpan) {
    const arrowIcon = restoreSpan.querySelector('.material-symbols-outlined');

    function setArrowDirection(isOpen) {
      if (arrowIcon) {
        arrowIcon.textContent = isOpen ? 'keyboard_arrow_up' : 'keyboard_arrow_down';
      }
    }

    function initializeState() {
      try {
        const isDismissed = localStorage.getItem('alertDismissed') === 'true';
        alertSection.style.display = isDismissed ? 'none' : 'block';
        setArrowDirection(!isDismissed);
      } catch (error) {
        console.error('Error accessing localStorage:', error);
		// Default to showing the alert if an error occurs
		alertSection.style.display = 'block';
		setArrowDirection(true);
      }
    }

    function toggleAlert() {
      try {
        const isVisible = alertSection.style.display === 'block';
        alertSection.style.display = isVisible ? 'none' : 'block';
        localStorage.setItem('alertDismissed', isVisible ? 'true' : 'false');
        setArrowDirection(!isVisible);
      } catch (error) {
        console.error('Error accessing localStorage:', error);
      }
    }

    dismissButton.addEventListener('click', toggleAlert);
    restoreSpan.addEventListener('click', toggleAlert);

    initializeState();
  }
  

  const parentDiv = document.querySelector('.dialog-off-canvas-main-canvas');
  if (parentDiv) {
    const firstChildDiv = parentDiv.querySelector('div');
    if (firstChildDiv) {
    firstChildDiv.classList.add('navigation', 'sticky-top', 'z-3');
    }
  }
window.addEventListener('scroll', function() {
  const header = document.getElementById('header');
  const alertSection = document.getElementById('alert-section');
  const topBar = document.querySelector('.top-bar');
  const navigation = document.querySelector('.navigation');
  const navigationHeight = navigation ? navigation.offsetHeight : 0;

  if (window.scrollY > navigationHeight) {
    if (header) {
      header.classList.add('sticky-top');
    }

    if (topBar) {
      topBar.style.display = 'none';
    }

    if (alertSection) {
      alertSection.style.display = 'none';
    }
  } else {
    if (header) {
      header.classList.remove('sticky-top');
    }

    if (topBar) {
      topBar.style.display = 'block';
    }

    if (alertSection) {
      if (localStorage.getItem('alertDismissed') !== 'true') {
        alertSection.style.display = 'block';
      } else {
        alertSection.style.display = 'none';
      }
    }
  }

});
});
</script>

