    {
      "id": "pace-drug-coordination",
      "topic": "pace",
      "text": "PACE provides its participants’ prescription coverage. Medicare.gov says joining a separate Medicare drug plan while enrolled in PACE causes disenrollment from PACE. Review existing health and drug coverage with the enrollment team before making changes.",
      "review_status": "publisher_source_check; qualified_domain_review_pending",
      "evidence": [
