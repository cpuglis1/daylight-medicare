    {
      "id": "coordination-va",
      "topic": "coordination_va",
      "text": "VA health benefits and Medicare have different payment and access rules. VA does not bill Medicare for care at a VA facility. VA drug coverage is creditable, but VA coverage does not automatically establish TRICARE For Life eligibility. Check the existing VA benefit and access to non-VA care before changing Medicare coverage.",
      "review_status": "publisher_source_check; qualified_domain_review_pending",
      "evidence": [
        {
          "id": "va-medicare-coordination",
          "requested_url": "https://www.va.gov/resources/veterans-turning-65-va-healthcare-medicare-and-tricare-for-life/",
          "sha256": "0168019b70410c583224ebccda17ca84484827482b42fdb778bdc101d3e513a3",
          "retrieved_at_utc": "2026-10-20T02:00:31.877099+00:00",
