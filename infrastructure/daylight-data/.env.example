# Infrastructure-only settings. Never copy the apps' guest databases or .env files.
DAYLIGHT_DATA_DATABASE_URL=postgresql://daylight_research@127.0.0.1:55485/daylight
DAYLIGHT_DATA_ARCHIVE_ROOT=/private/path/to/evidence-archive
# Use two separately generated secrets, each >=32 characters.
DAYLIGHT_DATA_SERVICE_TOKEN=
DAYLIGHT_DATA_CURSOR_SECRET=
