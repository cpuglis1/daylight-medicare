    "claims": [
      {
        "claim_id": "advantage",
        "retained_statement": "Medicare hospital and medical coverage through a private insurance company’s plan instead of Original Medicare. Most plans include drug coverage. Doctors, costs, and rules vary by plan. The Part B premium still applies; some plans help pay all or part of it. Check each plan's doctors, drug coverage, costs, and rules.",
        "local_evidence": {
          "path": "web/teaching-facts.json",
          "locator": "facts[id=advantage].text"
        },
        "official_source_urls": [
          "https://www.medicare.gov/basics/get-started-with-medicare/get-more-coverage/your-coverage-options"
        ],
        "scope": "general_education",
        "exceptions_and_conditions": "preserved_in_retained_statement",
        "review_state": "incumbent_project_teaching_not_new_independent_review",
        "permitted_uses": [
          "general_education"
        ],
        "personal_use": "held",
        "effective_period": "general_teaching_in_2026_pilot_not_a_personal_rule_release",
        "review_due": "2026-11-24"
      },
      {
        "claim_id": "cobra_timing",
        "retained_statement": "COBRA continues a former employer group health plan for a limited time after employment or dependent coverage ends. For Medicare enrollment, COBRA is not coverage based on current employment. For people turning 65 who have not signed up for Medicare, Medicare.gov warns not to wait until COBRA ends to sign up for Part B; COBRA does not extend the time to enroll. A preferred start after COBRA ends is a preference, not a finding that waiting is safe. Use actual Medicare enrollment status and the applicable official enrollment rules to establish a personal next step; do not calculate a personal deadline or effective date from the COBRA end alone.",
        "local_evidence": {
          "path": "advisor-evidence.json",
          "locator": "facts[id=cobra_timing].text"
        },
        "official_source_urls": [
          "https://www.medicare.gov/basics/get-started-with-medicare/medicare-basics/working-past-65",
          "https://www.medicare.gov/basics/get-started-with-medicare/medicare-basics/working-past-65/cobra-coverage"
        ],
        "scope": "general_education",
        "exceptions_and_conditions": "preserved_in_retained_statement",
        "review_state": "incumbent_project_teaching_not_new_independent_review",
        "permitted_uses": [
