      },
      {
        "claim_id": "enrollment_intro",
        "retained_statement": "For most people first becoming eligible at 65, the Initial Enrollment Period is a 7-month window: the 3 months before the birthday month, that month, and the 3 months after. The date coverage begins also depends on when enrollment happens and which enrollment period applies. Current health insurance matters: Medicare.gov checks the kind of insurance, whether job-based coverage comes from current employment, and employer size before giving timing guidance. Do not turn this general explanation into a personal start date, deadline, eligibility decision or permission to delay Part B. A first-of-month birthday has special start-date rules.",
        "local_evidence": {
          "path": "advisor-evidence.json",
          "locator": "facts[id=enrollment_intro].text"
        },
        "official_source_urls": [
          "https://www.medicare.gov/basics/get-started-with-medicare/sign-up/when-can-i-sign-up-for-medicare",
