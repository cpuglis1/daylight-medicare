        "personal_use": "held",
        "effective_period": "general_teaching_in_2026_pilot_not_a_personal_rule_release",
        "review_due": "2026-11-24"
      },
      {
        "claim_id": "costs",
        "retained_statement": "A premium is the amount you pay each month for coverage. A deductible is an amount you pay before coverage pays its share under the benefit's rules. Copays and coinsurance are costs when you use care. A plan's premium alone is not your total cost.",
        "local_evidence": {
          "path": "web/teaching-facts.json",
          "locator": "facts[id=costs].text"
        },
        "official_source_urls": [
