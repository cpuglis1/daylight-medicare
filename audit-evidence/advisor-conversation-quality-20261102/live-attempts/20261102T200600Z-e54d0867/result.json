        "type": "message",
        "message": "I do not know when I want coverage to start; I need help understanding the choices first. Are Original Medicare and Medicare Advantage two policies I buy together?"
      },
      "persona_policy": {
        "previous_target": "T04",
        "wording_branch": "T04",
        "facts_added_to_rescue_route": false
      },
      "expected_outcome": [
        "Treat desired start as unknown, not ASAP or an inferred month.",
