    body.chat-mode .typing-dot{animation:daylight-typing 1.1s ease-in-out infinite!important}
    body.chat-mode .typing-dot:nth-child(2){animation-delay:.14s!important}body.chat-mode .typing-dot:nth-child(3){animation-delay:.28s!important}
