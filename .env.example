# Server-side live Medicare conversation settings. Never put the key in client code.
# Load explicitly with: python3 scripts/demo.py serve --env-file /absolute/path/to/.env
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4
# The server saves visible conversations locally as .txt files, creates no customer profile,
# and sends API requests with store:false.
# External account data controls still apply. No env file is included in releases.
